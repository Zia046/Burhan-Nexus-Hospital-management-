<Project Sdk="Microsoft.NET.Sdk">
  <!-- Burhan Nexus HMS client launcher: a desktop window (WebView2) around the existing HMS web interface.
       It holds no database and no patient data - every page comes from the central HMS server. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>BurhanNexus.HMS.Client</AssemblyName>
    <RootNamespace>BurhanNexus.Launcher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Burhan Nexus HMS Client</Product>
    <Version>2.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
</Project>
