@page
@model BurhanNexus.HMS.Web.Pages.Opd.SetupModel
@{
    ViewData["Title"] = "OPD setup – doctors";
    var editDoc = Model.Doctors.FirstOrDefault(d => d.Id == Model.EditDoctorId);
    (decimal Fee, bool IsFree, int ServiceId)? editFee = editDoc is not null && Model.Fees.TryGetValue(editDoc.Id, out var ef) ? ef : null;
}
<div class="breadcrumbs"><a href="/Opd">OPD</a> <svg class="icon icon-sm"><use href="#i-chevron-right" /></svg> Setup</div>
<div class="toolbar">
    <h2><svg class="icon"><use href="#i-user-cross" /></svg> Doctors &amp; consultation fees</h2>
    <div class="toolbar-actions">
        <a bn-permission="@Perm.OpdSettings" class="btn btn-light" href="/Settings/Opd" data-test="opd-settings-link"><svg class="icon icon-sm"><use href="#i-sliders" /></svg> OPD settings (tokens, defaults)</a>
    </div>
</div>
<div class="grid-side">
    <div class="card">
        <div class="table-wrap">
            <table class="table table-compact" data-doctors>
                <thead><tr><th>Doctor</th><th>Specialty</th><th>Department</th><th class="num">Consultation fee</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var d in Model.Doctors)
                {
                    var has = Model.Fees.TryGetValue(d.Id, out var f);
                    <tr data-doctor="@d.Name"><td><strong>@d.Name</strong><small class="muted block">@d.Qualification</small></td><td>@d.Specialty</td><td>@d.Department?.Name</td>
                        <td class="num" data-doctor-fee>@if (!has) { <span class="status status-warn">Fee not set</span> } else { @Fmt.Fee(f.Fee, f.IsFree) }</td>
                        <td>@if (d.IsActive) { <span class="status status-ok">Active</span> } else { <span class="status status-off">Inactive</span> }</td>
                        <td class="actions"><a class="btn btn-light btn-xs" href="/Opd/Setup?doctor=@d.Id">Edit</a></td></tr>
                }
                @if (Model.Doctors.Count == 0) { <tr><td colspan="6" class="empty">No doctors yet – add the first doctor with the form.</td></tr> }
                </tbody>
            </table>
        </div>
        <div class="card-footer muted small">A doctor's consultation can be booked only when the fee is entered (or marked FREE). Other services and their fees: <a href="/Fees">Fees &amp; Services</a>.</div>
    </div>

    <form method="post" asp-page-handler="Doctor" asp-route-id="@editDoc?.Id" class="card" novalidate data-doctor-form>
        <div class="card-header"><h3>@(editDoc is null ? "Add doctor" : "Edit doctor")</h3></div>
        <div class="card-body">
            <div class="field"><label for="dn">Doctor name <em>*</em></label><input id="dn" name="DoctorForm.Name" value="@editDoc?.Name" required maxlength="150" placeholder="Dr. ..." /></div>
            <div class="field"><label for="dfee">Consultation fee (@((await Fmt.ProfileAsync())?.CurrencyCode))</label>
                <input id="dfee" name="ConsultationFee" type="number" min="0" step="0.01" value="@(editFee is { IsFree: false } x && x.Fee > 0 ? x.Fee.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" placeholder="e.g. 1000" data-test="doctor-fee" />
                <label class="check"><input type="checkbox" name="ConsultationFree" value="true" checked="@(editFee?.IsFree == true)" data-test="doctor-free" /> FREE consultation (no fee)</label>
                <small class="muted">Leave empty for doctors who do not see OPD patients (e.g. anaesthetist).</small></div>
            <div class="field"><label for="dsp">Specialty</label><input id="dsp" name="DoctorForm.Specialty" value="@editDoc?.Specialty" maxlength="100" /></div>
            <div class="field"><label for="dq">Qualification</label><input id="dq" name="DoctorForm.Qualification" value="@editDoc?.Qualification" maxlength="150" placeholder="MBBS, FCPS" /></div>
            <div class="field"><label for="ddp">Department</label>
                <select id="ddp" name="DoctorForm.DepartmentId"><option value="">—</option>
                    @foreach (var d in Model.Departments) { <option value="@d.Id" selected="@(editDoc?.DepartmentId == d.Id)">@d.Name</option> }</select></div>
            <div class="field"><label for="dreg">PMDC / registration no.</label><input id="dreg" name="DoctorForm.RegistrationNumber" value="@editDoc?.RegistrationNumber" maxlength="50" /></div>
            <label class="check"><input type="checkbox" name="DoctorForm.IsActive" value="true" checked="@(editDoc?.IsActive ?? true)" /> Active</label>
            <input type="hidden" name="DoctorForm.IsActive" value="false" />
        </div>
        <div class="card-footer form-actions">
            @if (editDoc is not null) { <a class="btn btn-light" href="/Opd/Setup">Cancel</a> }
            <button class="btn btn-primary" type="submit" data-test="doctor-save">@(editDoc is null ? "Add doctor" : "Save doctor")</button>
        </div>
    </form>
</div>
