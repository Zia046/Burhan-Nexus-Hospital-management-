@page
@model BurhanNexus.HMS.Web.Pages.Pharmacy.ReceiveModel
@using System.Text.Json
@{
    ViewData["Title"] = "Supplier invoice – receive stock";
    var initial = JsonSerializer.Serialize(Model.Lines.Select(l => new { id = l.MedicineId, name = l.MedicineName, batch = l.BatchNumber, expiry = l.Expiry, qty = l.Quantity, cost = l.UnitCost, sale = l.SalePrice, discount = l.Discount }));
}
<partial name="_PharmNav" />
<partial name="_ValidationSummary" />
<form method="post" class="card invoice-entry" data-invoice-form novalidate>
    <input type="hidden" asp-for="Input.IdempotencyKey" />
    <div class="card-header">
        <h2><svg class="icon"><use href="#i-download" /></svg> Supplier invoice <small class="muted">receive stock into Main Pharmacy</small></h2>
        <a class="btn btn-light btn-sm" href="/Pharmacy/Invoices" data-test="invoice-history"><svg class="icon icon-sm"><use href="#i-file" /></svg> Invoice history</a>
    </div>

    <div class="card-body form-grid invoice-header" data-invoice-header>
        <div class="field"><label for="Input_SupplierId">Supplier *</label>
            <select asp-for="Input.SupplierId" data-supplier-select data-test="invoice-supplier">
                <option value="">— select supplier —</option>
                @foreach (var s in Model.Suppliers) { <option value="@s.Id" data-details="@string.Join(" · ", new[] { s.ContactPerson, s.Phone, s.City }.Where(x => !string.IsNullOrWhiteSpace(x)))">@s.Name</option> }
            </select>
            <small class="muted" data-supplier-details></small>
            <small><a href="/Pharmacy/Suppliers/Edit" target="_blank" rel="noopener">+ New supplier</a></small></div>
        <div class="field"><label for="Input_ReferenceNumber">Invoice number *</label><input asp-for="Input.ReferenceNumber" maxlength="60" data-test="invoice-number" autocomplete="off" /></div>
        <div class="field"><label for="Input_InvoiceDate">Invoice date</label><input asp-for="Input.InvoiceDate" type="date" data-test="invoice-date" /></div>
        <div class="field"><label for="Input_ReceivedDate">Received on</label><input asp-for="Input.ReceivedDate" type="date" /></div>
        <div class="field"><label for="Input_SourceName">No supplier record? Source</label><input asp-for="Input.SourceName" maxlength="150" placeholder="e.g. District Health Office, donation" /></div>
        <div class="field"><label for="Input_Notes">Notes</label><input asp-for="Input.Notes" maxlength="500" /></div>
    </div>

    <div class="table-wrap invoice-table-wrap">
        <table class="table invoice-table" data-invoice-lines data-prices="@(Model.WithPrices ? "1" : "0")" data-saleprice="@(Model.CanSalePrice ? "1" : "0")" data-initial="@initial">
            <thead><tr>
                <th class="w-no">#</th><th class="w-med">Medicine *</th><th class="num">Quantity *</th><th>Expiry *</th><th>Batch no.</th>
                @if (Model.WithPrices) { <th class="num">Purchase price</th><th class="num">Sale price</th><th class="num">Adjustment (−)</th><th class="num">Line total</th> }
                <th></th>
            </tr></thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="card-body invoice-toolbar">
        <button type="button" class="btn btn-light" data-add-row data-test="add-item"><svg class="icon icon-sm"><use href="#i-plus" /></svg> Add item <kbd>Alt+N</kbd></button>
        @if (Model.CanAddMedicine) { <button type="button" class="btn btn-light" data-new-medicine-open data-test="new-medicine-open"><svg class="icon icon-sm"><use href="#i-pill" /></svg> New medicine (not in catalogue)</button> }
        <span class="muted small">Type 2+ letters in the Medicine box, ↑/↓ to choose, Enter to pick. Enter moves to the next box; Enter in the last box opens a new row.</span>
    </div>

    @if (Model.WithPrices)
    {
        <div class="card-body form-grid">
            <div class="field"><label for="Input_DiscountAmount">Invoice discount</label><input asp-for="Input.DiscountAmount" type="number" min="0" step="0.01" data-invoice-discount /></div>
            <div class="field"><label for="Input_AdditionalCharges">Additional charges (freight etc.)</label><input asp-for="Input.AdditionalCharges" type="number" min="0" step="0.01" data-invoice-charges /></div>
        </div>
    }

    <div class="invoice-summary" data-receive-summary>
        <div><span>Medicines / items</span><strong data-receive-count>0</strong></div>
        <div><span>Total quantity</span><strong data-receive-qty>0</strong></div>
        @if (Model.WithPrices) { <div><span>Purchase total</span><strong data-receive-purchase>0.00</strong></div><div><span>Invoice net</span><strong data-receive-net>0.00</strong></div> }
    </div>
    <div class="card-footer form-actions">
        <span class="muted">All rows are saved together in one step – every medicine or none. Saving twice never adds stock twice; the same supplier invoice number is refused. Sale prices stay as they are unless you change them (permission needed). Corrections later only through an authorised stock adjustment with a reason.</span>
        <button class="btn btn-primary btn-lg" type="submit" data-test="save-receipt" data-once>Save &amp; receive complete invoice</button>
    </div>
</form>

@if (Model.CanAddMedicine)
{
    <dialog class="modal" data-new-medicine>
        <form method="dialog" class="card" data-new-medicine-form>
            <div class="card-header"><h3>New medicine</h3></div>
            <div class="card-body form-grid">
                <div class="field span-2"><label for="NM_Name">Name *</label><input id="NM_Name" name="Name" maxlength="150" required /></div>
                <div class="field"><label for="NM_Generic">Generic name</label><input id="NM_Generic" name="GenericName" maxlength="150" /></div>
                <div class="field"><label for="NM_Strength">Strength</label><input id="NM_Strength" name="Strength" maxlength="50" placeholder="500mg" /></div>
                <div class="field"><label for="NM_Form">Dosage form</label><select id="NM_Form" name="DosageFormId"><option value="">—</option>@foreach (var f in Model.DosageForms) { <option value="@f.Id">@f.Name</option> }</select></div>
                <div class="field"><label for="NM_Unit">Unit</label><input id="NM_Unit" name="Unit" maxlength="30" placeholder="Tablet / Vial / Bottle" /></div>
                @if (Model.IsPrivate)
                {
                    <div class="field"><label for="NM_Cost">Purchase price</label><input id="NM_Cost" name="PurchasePrice" type="number" min="0" step="0.0001" /></div>
                    @if (Model.CanSalePrice) { <div class="field"><label for="NM_Sale">Sale price</label><input id="NM_Sale" name="SalePrice" type="number" min="0" step="0.01" /></div> }
                }
                <div class="field span-2" data-new-medicine-dup hidden><label class="check"><input type="checkbox" name="ConfirmDuplicate" value="true" /> <span data-new-medicine-dup-text></span> – create anyway</label></div>
                <div class="field span-2 text-danger" data-new-medicine-error></div>
            </div>
            <div class="card-footer form-actions">
                <button type="button" class="btn btn-light" data-new-medicine-cancel>Cancel</button>
                <button type="button" class="btn btn-primary" data-new-medicine-save data-test="new-medicine-save">Create and add to invoice</button>
            </div>
        </form>
    </dialog>
}
@section Scripts { <script src="~/js/pharmacy.js" asp-append-version="true"></script> }
