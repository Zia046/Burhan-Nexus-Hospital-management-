@page "{id:long}"
@model BurhanNexus.HMS.Web.Pages.Pharmacy.PatientHistoryModel
@using BurhanNexus.HMS.Core.Domain
@{ var p = Model.Patient; ViewData["Title"] = "Medicine history – " + p.FullName; }
<partial name="_PharmNav" />
<div class="card">
    <div class="card-body lab-patient">
        <div class="patient-id-box sm"><small>Patient ID</small><strong>@p.PatientNumber</strong></div>
        <div><h2>@p.FullName</h2><span class="muted">@p.Gender@(p.MobileNumber is null ? "" : " · " + p.MobileNumber)</span></div>
        <div class="actions"><a bn-permission="@Perm.PharmIssueToPatients" class="btn btn-primary btn-sm" href="/Pharmacy/Issue?patientId=@p.Id">Issue medicines</a> <a class="btn btn-light btn-sm" href="/Patients/Profile/@p.Id">Patient profile</a></div>
    </div>
</div>
<div class="card">
    <div class="card-header"><h3><svg class="icon"><use href="#i-history" /></svg> Medicines issued</h3><span class="pill">@Model.Rows.Count line(s)</span></div>
    <div class="table-wrap"><table class="table table-compact" data-patient-medicines>
        <thead><tr><th>Date</th><th>Issue</th><th>Visit</th><th>Medicine</th><th>Batch</th><th class="num">Qty</th><th class="num">Returned</th><th>Instructions</th><th>Issued by</th>@if (Model.ShowPrices) { <th class="num">Amount</th> }</tr></thead>
        <tbody>@foreach (var r in Model.Rows)
        { <tr data-history-row="@r.MedicineName"><td class="nowrap">@Fmt.Day(r.BusinessDate)</td><td class="mono"><a href="/Pharmacy/Doc/ISS/@r.IssueId">@r.IssueNumber</a></td>
            <td class="small">@r.EncounterNumber @(r.EncounterType is EncounterType.Opd ? "(OPD)" : r.EncounterType is EncounterType.Emergency ? "(Emergency)" : "")</td>
            <td>@r.MedicineName</td><td class="mono">@r.BatchNumber</td><td class="num">@r.Quantity</td><td class="num">@r.Returned</td><td class="small">@r.Instructions</td><td class="small">@r.IssuedBy</td>
            @if (Model.ShowPrices) { <td class="num">@r.LineTotal?.ToString("N2")</td> }</tr> }
        @if (Model.Rows.Count == 0) { <tr><td colspan="10" class="empty">No medicines issued yet.</td></tr> }</tbody>
    </table></div>
</div>
