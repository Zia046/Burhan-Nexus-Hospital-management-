@page "/Print/Pharmacy/{type}/{id:long}/{handler=Print}"
@model BurhanNexus.HMS.Web.Pages.Print.PharmacyModel
@using BurhanNexus.HMS.Core.Domain
@{
    Layout = null;
    var h = Model.Hospital;
    var prices = Model.ShowPrices;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Number</title>
    <link rel="stylesheet" href="~/css/thermal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lab-report.css" asp-append-version="true" />
    <script src="~/js/lab-report.js" asp-append-version="true" defer></script>
</head>
<body class="thermal-body w@(Model.Width)" data-pharmacy-slip="@Model.Number">
<div class="t-toolbar no-print">
    <div class="t-row">
        <strong>@Model.Number</strong>
        <a class="t-btn light" href="/Pharmacy/Doc/@Model.Type/@ViewContext.RouteData.Values["id"]">&larr; Back</a>
        <a class="t-btn light @(Model.Width == 58 ? "on" : "")" href="?width=58">58 mm</a>
        <a class="t-btn light @(Model.Width == 80 ? "on" : "")" href="?width=80">80 mm</a>
        <button type="button" class="t-btn" data-print-now>Print</button>
    </div>
</div>
<main class="slip-wrap">
<article class="t-slip">
    <div class="t-hosp">@h.HospitalName</div>
    <div class="t-small">@Model.PharmacyName</div>
    <div class="t-sep"></div>
    @if (Model.Issue is { } iss)
    {
        @{ var em = iss.EffectiveMode; }
        <div class="t-title" data-slip-mode="@em">@(em switch { BurhanNexus.HMS.Core.Domain.MedicineIssueMode.Free => "FREE MEDICINE ISSUE SLIP", BurhanNexus.HMS.Core.Domain.MedicineIssueMode.Subsidized => "SUBSIDIZED MEDICINE SLIP", _ => "MEDICINE ISSUE SLIP" })</div>
        @if (iss.ApprovalStatus == BurhanNexus.HMS.Core.Domain.FreeIssueApproval.Pending) { <div class="t-title">*** NOT APPROVED YET ***</div> }
        <table class="t-kv">
            <tr><td>Issue no.</td><td>@iss.Number</td></tr>
            <tr><td>Date</td><td>@Fmt.DateTimeText(iss.CreatedUtc)</td></tr>
            <tr><td>Patient</td><td>@iss.Patient!.FullName</td></tr>
            <tr><td>Patient ID</td><td>@iss.Patient.PatientNumber</td></tr>
            @if (iss.Encounter is { } e) { <tr><td>Visit</td><td>@e.EncounterNumber</td></tr> }
        </table>
        <div class="t-sep"></div>
        <table class="t-lines">
            @foreach (var i in iss.Items)
            {
                <tr><td>@i.MedicineName<br /><small>Batch @i.BatchNumber · Exp @i.ExpiryDate.ToString("MM/yyyy")</small>@if (i.Instructions is not null) { <br /><small>@i.Instructions</small> }</td>
                    <td class="r">× @i.Quantity@if (prices && i.LineTotal is decimal lt) { <br />@lt.ToString("N2") }</td></tr>
            }
        </table>
        @if (prices && iss.NetAmount is decimal net)
        {
            <div class="t-sep"></div><table class="t-kv">
                @if ((iss.SubsidyAmount ?? 0) > 0 || (iss.DiscountAmount ?? 0) > 0)
                {
                    <tr><td>Medicine value</td><td>@((iss.TotalValue ?? iss.GrossAmount ?? 0).ToString("N2"))</td></tr>
                    @if ((iss.DiscountAmount ?? 0) > 0) { <tr><td>Discount</td><td>@iss.DiscountAmount?.ToString("N2")</td></tr> }
                    @if ((iss.SubsidyAmount ?? 0) > 0) { <tr><td>Subsidy</td><td>@iss.SubsidyAmount?.ToString("N2")</td></tr> }
                }
                <tr><td><strong>Total</strong></td><td><strong>@net.ToString("N2")</strong></td></tr></table><div class="t-tiny">Please pay at the cash counter.</div>
        }
        @if (em == BurhanNexus.HMS.Core.Domain.MedicineIssueMode.Free) { <div class="t-sep"></div><div class="t-tiny">Free of charge – no payment.</div> }
        <div class="t-sep"></div><div class="t-tiny">Issued by @iss.CreatedByUsername</div>
    }
    @if (Model.Sale is { } sale)
    {
        <div class="t-title">PHARMACY RECEIPT</div>
        <table class="t-kv">
            <tr><td>Receipt no.</td><td>@sale.Receipt?.ReceiptNumber</td></tr>
            <tr><td>Sale no.</td><td>@sale.Number</td></tr>
            <tr><td>Date</td><td>@Fmt.DateTimeText(sale.CreatedUtc)</td></tr>
            <tr><td>Customer</td><td>@(sale.CustomerName ?? "Walk-in customer")</td></tr>
        </table>
        <div class="t-sep"></div>
        <table class="t-lines">
            @foreach (var i in sale.Items)
            {
                <tr><td>@i.MedicineName<br /><small>@i.Quantity × @i.UnitPrice.ToString("N2")@(i.Discount > 0 ? $" − disc {i.Discount:N2}" : "") · Exp @i.ExpiryDate.ToString("MM/yyyy")</small></td><td class="r">@i.LineTotal.ToString("N2")</td></tr>
            }
        </table>
        <div class="t-sep"></div>
        <table class="t-kv">
            <tr><td>Gross</td><td>@sale.GrossAmount.ToString("N2")</td></tr>
            @if (sale.DiscountAmount > 0) { <tr><td>Discount</td><td>− @sale.DiscountAmount.ToString("N2")</td></tr> }
            <tr><td><strong>Total</strong></td><td><strong data-slip-total>@Fmt.Money(sale.NetAmount)</strong></td></tr>
            <tr><td>Payment</td><td>@sale.Receipt?.PaymentMethod?.Name</td></tr>
            <tr><td>Cashier</td><td>@sale.CreatedByUsername</td></tr>
        </table>
    }
    @if (Model.Transfer is { } t)
    {
        <div class="t-title">STOCK TRANSFER SLIP</div>
        <table class="t-kv">
            <tr><td>Transfer no.</td><td>@t.Number</td></tr><tr><td>Date</td><td>@Fmt.DateTimeText(t.CreatedUtc)</td></tr>
            <tr><td>From</td><td>@t.FromLocation!.Name</td></tr><tr><td>To</td><td>@t.ToLocation!.Name</td></tr>
            @if (t.Reference is not null) { <tr><td>Reference</td><td>@t.Reference</td></tr> }
        </table>
        <div class="t-sep"></div>
        <table class="t-lines">@foreach (var i in t.Items) { <tr><td>@i.MedicineName<br /><small>Batch @i.BatchNumber · Exp @i.ExpiryDate.ToString("MM/yyyy")</small></td><td class="r">× @i.Quantity</td></tr> }</table>
        <div class="t-sep"></div>
        <div class="t-tiny">Issued by @t.CreatedByUsername</div><br /><div class="t-tiny">Received by: ____________________</div>
    }
    @if (Model.Receipt is { } g)
    {
        <div class="t-title">GOODS RECEIVED NOTE</div>
        <table class="t-kv"><tr><td>GRN</td><td>@g.Number</td></tr><tr><td>Date</td><td>@Fmt.Day(g.ReceivedDate)</td></tr><tr><td>From</td><td>@(g.Supplier?.Name ?? g.SourceName)</td></tr>
            @if (g.ReferenceNumber is not null) { <tr><td>Reference</td><td>@g.ReferenceNumber</td></tr> }</table>
        <div class="t-sep"></div>
        <table class="t-lines">@foreach (var i in g.Items) { <tr><td>@i.MedicineName<br /><small>Batch @i.BatchNumber · Exp @i.ExpiryDate.ToString("MM/yyyy")</small></td><td class="r">× @i.Quantity@if (prices && i.LineTotal is decimal lt) { <br />@lt.ToString("N2") }</td></tr> }</table>
        @if (prices && g.NetAmount is decimal n) { <div class="t-sep"></div><table class="t-kv"><tr><td><strong>Net</strong></td><td><strong>@n.ToString("N2")</strong></td></tr></table> }
        <div class="t-sep"></div><div class="t-tiny">Received by @g.CreatedByUsername</div>
    }
    @if (Model.Return is { } ret)
    {
        <div class="t-title">RETURN SLIP</div>
        <table class="t-kv"><tr><td>Return no.</td><td>@ret.Number</td></tr><tr><td>Date</td><td>@Fmt.DateTimeText(ret.CreatedUtc)</td></tr><tr><td>Against</td><td>@(ret.Sale?.Number ?? ret.Issue?.Number)</td></tr></table>
        <div class="t-sep"></div>
        <table class="t-lines">@foreach (var i in ret.Items) { <tr><td>@i.MedicineName<br /><small>Batch @i.BatchNumber · @(i.Restocked ? "back to stock" : "not restocked")</small></td><td class="r">× @i.Quantity@if (prices && i.Amount is decimal a) { <br />@a.ToString("N2") }</td></tr> }</table>
        <div class="t-sep"></div><div class="t-tiny">Reason: @ret.Reason</div>
        @if (ret.Refund is { } rf) { <div class="t-tiny">Refund @rf.RefundNumber: @rf.Status</div> }
    }
    @if (Model.SupplierReturn is { } sr)
    {
        <div class="t-title">SUPPLIER RETURN</div>
        <table class="t-kv"><tr><td>No.</td><td>@sr.Number</td></tr><tr><td>Date</td><td>@Fmt.DateTimeText(sr.CreatedUtc)</td></tr><tr><td>To</td><td>@(sr.Supplier?.Name ?? sr.SourceName)</td></tr></table>
        <div class="t-sep"></div>
        <table class="t-lines">@foreach (var i in sr.Items) { <tr><td>@i.MedicineName<br /><small>Batch @i.BatchNumber</small></td><td class="r">× @i.Quantity</td></tr> }</table>
        <div class="t-sep"></div><div class="t-tiny">Reason: @sr.Reason</div>
    }
    <div class="t-sep"></div>
    @if (Model.Footer is not null) { <div class="t-tiny">@Model.Footer</div> }
</article>
</main>
</body>
</html>
