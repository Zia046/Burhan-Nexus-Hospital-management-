@page
@model BurhanNexus.HMS.Web.Pages.Settings.LicenseModel
@{
    ViewData["Title"] = "License";
    var s = Model.Status;
    var ok = s.AllowsWrite;
    var requestCode = $"{s.InstallationId}|{Model.MachineId}";
}
<partial name="_SettingsNav" />
@if (Model.ReadOnlyRedirect && !ok)
{
    <div class="alert alert-danger"><svg class="icon"><use href="#i-lock" /></svg><div><strong>The system is in read-only mode.</strong> You can view records, take backups and activate a licence. No data has been deleted.</div></div>
}
@if (s.ExpiresSoon)
{
    <div class="alert alert-warning" data-license-warning><svg class="icon"><use href="#i-clock" /></svg><div><strong>Your licence expires in @s.DaysRemaining day(s)</strong> (@Fmt.Date(s.ExpiresUtc)). Send the activation request code below to Burhan Nexus and enter the renewal key before that date – after expiry the system becomes read-only (no data is lost).</div></div>
}
<div class="grid-side">
    <div class="card">
        <div class="card-header"><h3><svg class="icon"><use href="#i-key" /></svg> Licence status</h3>
            <span class="pill @(ok ? (s.State == LicenseState.TrialActive || s.ExpiresSoon ? "pill-warning" : "pill-success") : "pill-danger")" data-license-state="@s.State">@s.DisplayName</span></div>
        <div class="card-body">
            <p data-license-message>@s.Message</p>
            @if (s.State == LicenseState.TrialActive && s.DaysRemaining is int d)
            {
                <progress class="progress-bar" max="30" value="@(30 - Math.Clamp(d, 0, 30))"></progress>
                <p class="muted small">@d of 30 trial days remaining</p>
            }
            <dl class="kv">
                <dt>Licence ID</dt><dd class="mono" data-license-id>@(s.LicenseId ?? "—")</dd>
                <dt>Licence type</dt><dd>@(s.Type == BurhanNexus.HMS.Core.Domain.LicenseType.Trial ? "Trial" : s.Term ?? s.Type?.ToString() ?? "—")</dd>
                <dt>Licensed to</dt><dd>@(s.LicensedTo ?? "—")</dd>
                <dt>Trial started</dt><dd>@Fmt.Date(s.StartedUtc)</dd>
                <dt>Activation date</dt><dd>@Fmt.Date(s.ActivatedUtc)</dd>
                <dt>Expiry date</dt><dd>@(s.Type == BurhanNexus.HMS.Core.Domain.LicenseType.Lifetime ? "Never (lifetime)" : Fmt.Date(s.ExpiresUtc))</dd>
                @if (s.DaysRemaining is int left && s.Type != BurhanNexus.HMS.Core.Domain.LicenseType.Lifetime)
                {
                    <dt>Days remaining</dt><dd>@left</dd>
                }
            </dl>
        </div>
    </div>
    <div>
        <div class="card">
            <div class="card-header"><h3><svg class="icon"><use href="#i-shield" /></svg> Activation request</h3></div>
            <div class="card-body">
                <dl class="kv">
                    <dt>Installation ID</dt><dd class="mono" data-installation-id>@s.InstallationId</dd>
                    <dt>Machine ID</dt><dd class="mono" data-machine-id>@Model.MachineId</dd>
                </dl>
                <div class="field">
                    <label for="RequestCode">Activation request code</label>
                    <div class="input-group">
                        <input id="RequestCode" class="mono" readonly value="@requestCode" data-copy-source />
                        <button type="button" class="btn btn-light" data-copy-button="#RequestCode">Copy</button>
                    </div>
                </div>
                <p class="muted small">Send this code to Burhan Nexus (WhatsApp / e-mail) together with the hospital name and the licence you need – Lifetime, Yearly or a custom period. You receive an activation key made only for this installation and computer.</p>
            </div>
        </div>
        <form method="post" class="card" bn-permission="@Perm.LicenseActivate">
            <div class="card-header"><h3><svg class="icon"><use href="#i-check" /></svg> @(s.State == LicenseState.Active ? "Renew / replace licence" : "Activate licence")</h3></div>
            <div class="card-body">
                <div class="field">
                    <label for="ActivationKey">Activation key</label>
                    <textarea id="ActivationKey" name="ActivationKey" rows="5" class="mono" placeholder="BNHMS1-..." required maxlength="4000" data-test="activation-key"></textarea>
                </div>
                <p class="muted small">The key is checked on this computer with the Burhan Nexus digital signature – no internet connection is needed. A changed or self-made key is always refused.</p>
            </div>
            <div class="card-footer form-actions"><button class="btn btn-primary" type="submit"><svg class="icon icon-sm"><use href="#i-check" /></svg> Activate</button></div>
        </form>
        @if (s.State == LicenseState.Active && s.Type != BurhanNexus.HMS.Core.Domain.LicenseType.Trial)
        {
            <form method="post" asp-page-handler="Deactivate" class="card" bn-permission="@Perm.LicenseActivate" data-license-deactivate>
                <div class="card-header"><h3><svg class="icon"><use href="#i-lock" /></svg> Deactivate licence</h3></div>
                <div class="card-body">
                    <p class="muted small">For moving the software to another computer or ending a licence. After deactivation the system becomes read-only (all data is kept) and this licence ID cannot be activated here again.</p>
                    <div class="field">
                        <label for="Reason">Reason</label>
                        <input id="Reason" name="Reason" maxlength="300" required />
                    </div>
                    <label class="check"><input type="checkbox" name="Confirm" value="true" required /> I understand the system becomes read-only until a new key is activated.</label>
                </div>
                <div class="card-footer form-actions"><button class="btn btn-danger" type="submit">Deactivate licence</button></div>
            </form>
        }
    </div>
</div>
