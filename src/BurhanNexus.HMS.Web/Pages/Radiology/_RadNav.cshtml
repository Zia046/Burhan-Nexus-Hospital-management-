    <a bn-permission="@Perm.RadViewXRay" class="@Cls("xray")" href="/Radiology/Worklist/XRay"><svg class="icon icon-sm"><use href="#i-scan" /></svg> X-Ray</a>
    <a bn-permission="@Perm.RadViewUltrasound" class="@Cls("ultrasound")" href="/Radiology/Worklist/Ultrasound"><svg class="icon icon-sm"><use href="#i-wave" /></svg> Ultrasound</a>
