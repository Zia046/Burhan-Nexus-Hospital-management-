@page
@model BurhanNexus.HMS.Web.Pages.Radiology.HistoryModel
@{ ViewData["Title"] = "Radiology patient history"; }
<partial name="_RadNav" />
<div class="card card-medium">
    <div class="card-header"><h2><svg class="icon"><use href="#i-history" /></svg> Patient radiology history</h2></div>
    <div class="card-body">
        <form method="get" class="search-main">
            <div class="input-icon grow"><svg class="icon"><use href="#i-search" /></svg><input name="q" value="@Model.Q" placeholder="Patient ID, name, phone or CNIC" autofocus maxlength="100" /></div>
            <button class="btn btn-primary" type="submit">Search</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.Q))
        {
            <table class="table table-compact" data-matches>
                <thead><tr><th>Patient ID</th><th>Name</th><th>Father / Husband</th><th>Age</th><th>Phone</th><th></th></tr></thead>
                <tbody>
                @foreach (var m in Model.Matches)
                {
                    <tr><td class="mono">@m.PatientNumber</td><td><strong>@m.FullName</strong></td><td>@m.GuardianName</td><td>@m.AgeText · @m.Gender</td><td>@m.MobileNumber</td>
                        <td class="actions"><a class="btn btn-primary btn-sm" href="/Radiology/Patient/@m.Id">Open history</a></td></tr>
                }
                @if (Model.Matches.Count == 0) { <tr><td colspan="6" class="empty">No patient found.</td></tr> }
                </tbody>
            </table>
        }
    </div>
</div>
