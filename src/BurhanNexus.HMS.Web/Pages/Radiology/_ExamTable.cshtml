@model (IReadOnlyList<RadiologyExamRow> Rows, string Key, string Empty, string Action)
<div class="table-wrap">
    <table class="table" data-rad-table="@Model.Key">
        <thead><tr><th>Token</th><th>Patient</th><th>Examination</th><th>Date</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr class="@(r.Priority == RadiologyPriority.Urgent ? "row-urgent" : "") @(r.Status == RadiologyExamStatus.Cancelled ? "row-muted" : "")" data-exam="@r.ServiceCode" data-patient="@r.PatientNumber">
                <td><span class="token-badge">@(r.Modality == RadiologyModality.XRay ? "X" : "U")-@r.TokenNumber</span></td>
                <td><strong>@r.PatientName</strong><small class="muted block">@r.PatientNumber · @r.AgeGender</small></td>
                <td>@r.ServiceName @if (r.Priority == RadiologyPriority.Urgent) { <span class="status status-bad">Urgent</span> }<small class="muted block mono">@r.OrderNumber</small>
                    @if (r.CorrectionReason is not null && r.Status == RadiologyExamStatus.ReportPending) { <small class="text-danger block">↩ @r.CorrectionReason</small> }
                    @if (r.ReportedBy is not null && r.Status == RadiologyExamStatus.AwaitingVerification) { <small class="muted block">Reported by @r.ReportedBy</small> }</td>
                <td class="nowrap">@Fmt.Day(r.ScheduledDate)</td>
                <td><partial name="_RadStatus" model="r.Status" /></td>
                <td class="actions nowrap">
                    @switch (Model.Action)
                    {
                        case "report": <a class="btn btn-primary btn-sm" href="/Radiology/Report/@r.Id" data-test="report-@r.ServiceCode">@(r.Status == RadiologyExamStatus.ExamCompleted ? "Write report" : "Continue")</a> break;
                        case "verify": <a class="btn btn-primary btn-sm" href="/Radiology/Exam/@r.Id#verify" data-test="verify-@r.ServiceCode">Review</a> break;
                    }
                    <a class="btn btn-light btn-sm" href="/Radiology/Exam/@r.Id">Open</a>
                    <a class="btn btn-light btn-sm" href="/Radiology/Order/@r.OrderId">Order</a>
                </td>
            </tr>
        }
        @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="empty">@Model.Empty</td></tr> }
        </tbody>
    </table>
</div>
