@page "{id:long}"
@model BurhanNexus.HMS.Web.Pages.Patients.ProfileModel
@{
    var p = Model.Patient;
    ViewData["Title"] = p.FullName;
    var active = p.Status == PatientStatus.Active;
    var rel = BurhanNexus.HMS.Web.Pages.Print.SlipModelBase.RelationLabel(p.GuardianRelation);
}
<div class="breadcrumbs"><a bn-permission="@Perm.PatientsSearch" href="/Patients">Patients</a> <svg class="icon icon-sm"><use href="#i-chevron-right" /></svg> @p.PatientNumber</div>

@if (p.Status == PatientStatus.Merged)
{
    <div class="alert alert-warning"><svg class="icon"><use href="#i-info" /></svg><div>This was a <strong>duplicate registration</strong> and was merged into
        <a href="/Patients/Profile/@p.MergedIntoPatientId"><strong>@p.MergedIntoPatient?.PatientNumber – @p.MergedIntoPatient?.FullName</strong></a>. Its visits are shown there. Reason: @p.StatusReason</div></div>
}
else if (p.Status == PatientStatus.Archived)
{
    <div class="alert alert-warning"><svg class="icon"><use href="#i-info" /></svg><div>This record is <strong>archived</strong> (@Fmt.DateTimeText(p.ArchivedUtc)): @p.StatusReason. New visits cannot be registered until it is restored.</div></div>
}
@if (p.IsUnidentified)
{
    <div class="alert alert-info"><svg class="icon"><use href="#i-alert" /></svg><div><strong>Temporary registration</strong> of an unidentified patient. Please complete the name and details when known.</div></div>
}

<section class="card patient-head">
    <div class="patient-id-box">
        <small>Patient ID</small>
        <strong data-patient-number>@p.PatientNumber</strong>
    </div>
    <div class="grow">
        <h2>@p.FullName</h2>
        <p class="muted">@(p.GuardianName is null ? "" : $"{rel} {p.GuardianName} · ")@Model.AgeText · @p.Gender@(p.BloodGroup is null ? "" : " · Blood group " + p.BloodGroup)</p>
        <p>
            @if (active) { <span class="status status-ok">Active</span> } else { <span class="status status-off">@p.Status</span> }
            <span class="muted small">Registered @Fmt.DateTimeText(p.RegisteredUtc)</span>
        </p>
    </div>
    <div class="profile-actions">
        @if (active)
        {
            <a bn-permission="@Perm.OpdAdd" class="btn btn-primary" href="/Opd/Register?patientId=@p.Id"><svg class="icon icon-sm"><use href="#i-stethoscope" /></svg> New OPD visit</a>
            <a bn-permission="@Perm.EmergencyAdd" class="btn btn-danger-outline" href="/Emergency/Register?patientId=@p.Id"><svg class="icon icon-sm"><use href="#i-siren" /></svg> Emergency</a>
        }
        @if (p.Status != PatientStatus.Merged)
        {
            <a bn-permission="@Perm.PatientsEdit" class="btn btn-light" href="/Patients/Edit/@p.Id"><svg class="icon icon-sm"><use href="#i-edit" /></svg> Edit</a>
        }
        <a bn-permission="@Perm.FinanceCollect" class="btn btn-light" href="/Finance/Collect?patientId=@p.Id"><svg class="icon icon-sm"><use href="#i-wallet" /></svg> Collect payment</a>
        <a bn-permission="@Perm.PharmIssueToPatients" class="btn btn-light" href="/Pharmacy/Issue?patientId=@p.Id" data-test="profile-issue-medicines"><svg class="icon icon-sm"><use href="#i-pill" /></svg> Issue medicines</a>
        <a bn-permission="@Perm.IpdRegisterAdmission" class="btn btn-light" href="/Ipd/Admit?patientId=@p.Id" data-test="profile-admit"><svg class="icon icon-sm"><use href="#i-hospital" /></svg> Admit (IPD)</a>
        <a bn-permission="@Perm.OtCreateBooking" class="btn btn-light" href="/Ot/Book?patientId=@p.Id" data-test="profile-book-surgery"><svg class="icon icon-sm"><use href="#i-scissors" /></svg> Book surgery</a>
        @if (p.Gender == Gender.Female) { <a bn-permission="@Perm.IpdViewGynae" class="btn btn-light" href="/Ipd/Gynae/Patient/@p.Id" data-test="profile-gynae"><svg class="icon icon-sm"><use href="#i-stethoscope" /></svg> Gynae / ANC</a> }
        <a bn-permission="@Perm.RadCreateBooking" class="btn btn-light" href="/Radiology/Book?patientId=@p.Id" data-test="profile-book-radiology"><svg class="icon icon-sm"><use href="#i-scan" /></svg> X-Ray / Ultrasound</a>
        <a bn-permission="@Perm.PatientsPrint" class="btn btn-light" href="/Patients/Record/@p.Id" target="_blank"><svg class="icon icon-sm"><use href="#i-printer" /></svg> Print record</a>
    </div>
</section>

<div class="grid-side">
    <div>
        @if (Model.CanSeeVisits)
        {
            <div class="card">
                <div class="card-header">
                    <h3><svg class="icon"><use href="#i-history" /></svg> Visit history</h3>
                    <span class="muted small"><span class="tag tag-blue">OPD @Model.OpdCount</span> <span class="tag tag-red">Emergency @Model.EmergencyCount</span></span>
                </div>
                <form method="get" class="card-body filters wrap">
                    <select name="type" aria-label="Visit type">
                        <option value="">All visits</option>
                        <option value="opd" selected="@(Model.TypeFilter == "opd")">OPD</option>
                        <option value="emergency" selected="@(Model.TypeFilter == "emergency")">Emergency</option>
                    </select>
                    <label class="inline-label">From <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
                    <label class="inline-label">To <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>
                    <button class="btn btn-light btn-sm" type="submit">Filter</button>
                </form>
                <div class="table-wrap">
                    <table class="table" data-visits>
                        <thead><tr><th>Date &amp; time</th><th>Type</th><th>Visit no.</th><th>Department / doctor</th><th>Details</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var v in Model.Visits.Items)
                        {
                            var url = v.Type == EncounterType.Opd ? $"/Opd/Visit/{v.Id}" : $"/Emergency/Visit/{v.Id}";
                            <tr>
                                <td class="nowrap">@Fmt.DateTimeText(v.EncounterUtc)</td>
                                <td>@if (v.Type == EncounterType.Opd) { <span class="tag tag-blue">OPD</span> } else { <span class="tag tag-red">Emergency</span> }</td>
                                <td class="mono nowrap">@v.EncounterNumber</td>
                                <td>@v.DepartmentName@(v.DoctorName is null ? "" : " · " + v.DoctorName)</td>
                                <td>@if (v.EmergencyStatus is { } st) { <span class="status @(st is EmergencyStatus.Registered or EmergencyStatus.UnderTreatment ? "status-warn" : "status-ok")">@EncounterService.Label(st)</span> } @v.Complaint</td>
                                <td class="actions nowrap">
                                    @if (v.Type == EncounterType.Opd)
                                    {
                                        <a bn-permission="@Perm.OpdView" class="btn btn-light btn-xs" href="@url">Open</a>
                                        <a bn-permission="@Perm.OpdPrint" class="btn btn-light btn-xs" href="/Print/Opd/@v.Id" target="_blank">Slip</a>
                                    }
                                    else
                                    {
                                        <a bn-permission="@Perm.EmergencyView" class="btn btn-light btn-xs" href="@url">Open</a>
                                        <a bn-permission="@Perm.EmergencyPrint" class="btn btn-light btn-xs" href="/Print/Emergency/@v.Id" target="_blank">Slip</a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (Model.Visits.Items.Count == 0) { <tr><td colspan="6" class="empty">No visits recorded.</td></tr> }
                        </tbody>
                    </table>
                </div>
                <partial name="_Pager" model="new PagerModel(Request, Model.Visits.Page, Model.Visits.TotalPages, Model.Visits.Total)" />
            </div>
        }
        else
        {
            <div class="card"><div class="card-body muted">You do not have permission to view this patient's previous visits.</div></div>
        }
    </div>

    <div class="stack">
        @if (Model.Diseases is { } dis)
        {
            <div class="card" id="diseases" data-profile-diseases>
                <div class="card-header"><h3><svg class="icon"><use href="#i-activity" /></svg> Disease history</h3></div>
                <div class="table-wrap"><table class="table table-compact"><tbody>
                    @foreach (var x in dis) { <tr data-disease-record="@x.Disease?.Name"><td class="small nowrap">@Fmt.Day(x.VisitDate)</td><td><strong>@x.Disease?.Name</strong>@if (x.Disease is { IsActive: false }) { <small class="muted"> (inactive)</small> }</td><td class="small">@(x.Encounter?.EncounterNumber ?? "Registration")</td><td class="small">@(x.AgeYears is int ay ? ay + " y" : "")</td><td class="small">@x.CreatedByUsername</td></tr> }
                    @if (dis.Count == 0) { <tr><td class="empty">No diseases recorded.</td></tr> }
                </tbody></table></div>
                @if (Model.CanAddDisease)
                {
                    <form method="post" asp-page-handler="Disease" class="card-body form-grid" data-add-patient-disease>
                        <div class="span-2"><partial name="_DiseasePicker" model="@string.Empty" /></div>
                        <div class="field"><label for="visitDate">Visit date</label><input id="visitDate" name="visitDate" type="date" /></div>
                        <div class="field"><label>&nbsp;</label><button class="btn btn-primary btn-sm" type="submit">Add disease</button></div>
                    </form>
                }
            </div>
        }
        @if (Model.Consultations is { } cons && cons.Count > 0)
        {
            <div class="card" id="consultations" data-profile-consultations>
                <div class="card-header"><h3><svg class="icon"><use href="#i-calendar" /></svg> Consultations – fee</h3></div>
                <div class="table-wrap"><table class="table table-compact">
                    <thead><tr><th>Date</th><th>Doctor</th><th class="num">Fee</th><th class="num">Paid</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var c in cons)
                    {
                        var ap = c.Appointment;
                        <tr data-consultation="@c.AppointmentId">
                            <td class="small nowrap">@Fmt.Day(c.Date) · T@(c.Token)</td><td>@c.Doctor</td><td class="num">@Fmt.Money(c.Fee)</td><td class="num">@Fmt.Money(c.Collected)</td>
                            <td class="small">
                                @if (c.Payment == AppointmentPayment.FreeByDoctor) { <span class="status status-ok" data-free-by-doctor>Free by Doctor</span> <span class="muted">@ap.WaiverDoctorName – @ap.WaiverReason (@ap.WaivedByUsername, @Fmt.DateTimeText(ap.WaivedUtc))</span> }
                                else if (c.Payment == AppointmentPayment.Free) { <span class="status">Free</span> }
                                else { <span class="status">@(c.Collected > 0 ? "Paid" : c.ChargeUnpaid ? "Unpaid" : c.Payment.ToString())</span> }
                                @if (ap.DiscountAmount is decimal da) { <div data-consultation-discount>Discount: @(ap.DiscountType == "Percent" ? $"{ap.DiscountValue:0.##}%" : "fixed") = @Fmt.Money(da) · original @Fmt.Money(ap.DiscountOriginalFee ?? 0) → final @Fmt.Money((ap.DiscountOriginalFee ?? 0) - da) · @ap.DiscountReason (@ap.DiscountedByUsername, @Fmt.DateTimeText(ap.DiscountedUtc))</div> }
                                @foreach (var r in c.Refunds) { <div data-consultation-refund="@r.Status">Refund @r.Number: @Fmt.Money(r.Amount) – <strong>@r.Status</strong> · @r.Reason (@r.By, @Fmt.DateTimeText(r.RequestedUtc))</div> }
                            </td>
                        </tr>
                        @if (ap.Status != AppointmentStatus.Cancelled && c.Payment is not (AppointmentPayment.FreeByDoctor or AppointmentPayment.Free))
                        {
                            <tr class="no-print"><td colspan="5"><div class="toolbar-actions wrap">
                                @if (Model.CanReturnFee && c.Returnable > 0)
                                {
                                    <form method="post" asp-page-handler="ReturnFee" class="inline-form" data-return-fee data-confirm="Return this consultation fee to the patient?">
                                        <input type="hidden" name="appointmentId" value="@c.AppointmentId" />
                                        <input name="amount" type="number" step="0.01" min="0.01" max="@c.Returnable.ToString(System.Globalization.CultureInfo.InvariantCulture)" value="@c.Returnable.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="input-sm" aria-label="Amount to return" />
                                        <input name="reason" maxlength="250" placeholder="Reason *" required class="input-sm" />
                                        <button class="btn btn-light btn-sm" type="submit">Return Fee</button></form>
                                }
                                @if (Model.CanFreeByDoctor)
                                {
                                    <form method="post" asp-page-handler="FreeByDoctor" class="inline-form" data-free-form data-confirm="Mark this consultation as Free by Doctor?@(c.Returnable > 0 ? " The collected fee will be refunded." : "")">
                                        <input type="hidden" name="appointmentId" value="@c.AppointmentId" />
                                        <input name="reason" maxlength="250" placeholder="Reason *" required class="input-sm" />
                                        <button class="btn btn-light btn-sm" type="submit">Free by Doctor</button></form>
                                }
                                @if (Model.CanDiscount && ap.DiscountAmount is null)
                                {
                                    <form method="post" asp-page-handler="Discount" class="inline-form" data-discount-form>
                                        <input type="hidden" name="appointmentId" value="@c.AppointmentId" />
                                        <select name="discountType" aria-label="Discount type"><option value="Fixed">Fixed (Rs.)</option><option value="Percent">Percent (%)</option></select>
                                        <input name="value" type="number" step="0.01" min="0.01" class="input-sm" placeholder="Value" aria-label="Discount value" />
                                        <input name="reason" maxlength="250" placeholder="Reason *" required class="input-sm" />
                                        <button class="btn btn-light btn-sm" type="submit">Discount</button></form>
                                }
                            </div></td></tr>
                        }
                    }
                    </tbody>
                </table></div>
            </div>
        }
        @if (Model.Medicines is { } meds)
        {
            <div class="card" data-profile-medicines>
                <div class="card-header"><h3><svg class="icon"><use href="#i-pill" /></svg> Medicines issued</h3><a class="btn btn-light btn-sm" href="/Pharmacy/PatientHistory/@p.Id">All</a></div>
                <div class="table-wrap"><table class="table table-compact"><tbody>
                    @foreach (var m in meds) { <tr><td class="small nowrap">@Fmt.Day(m.BusinessDate)</td><td>@m.MedicineName</td><td class="num">@m.Quantity</td><td class="mono small">@m.BatchNumber</td><td class="small">@m.EncounterNumber</td><td class="small">@m.IssuedBy</td></tr> }
                    @if (meds.Count == 0) { <tr><td class="empty">No medicines issued.</td></tr> }
                </tbody></table></div>
            </div>
        }
        @if (Model.Admissions is { } adms)
        {
            <div class="card" data-profile-ipd>
                <div class="card-header"><h3><svg class="icon"><use href="#i-hospital" /></svg> IPD admissions</h3></div>
                <div class="table-wrap"><table class="table table-compact"><tbody>
                    @foreach (var x in adms) { <tr><td class="small nowrap">@Fmt.DateTimeText(x.AdmittedUtc)</td><td><a href="/Ipd/Admission/@x.Id">@x.AdmissionNumber</a></td><td class="small">@x.Kind · @(x.Ward ?? "—") @x.Bed</td><td class="small"><partial name="/Pages/Ipd/_AdmStatus.cshtml" model="x.Status" /></td></tr> }
                    @if (adms.Count == 0) { <tr><td class="empty">No admissions.</td></tr> }
                </tbody></table></div>
            </div>
        }
        @if (Model.Surgeries is { } surg)
        {
            <div class="card" data-profile-ot>
                <div class="card-header"><h3><svg class="icon"><use href="#i-scissors" /></svg> Surgeries</h3><a bn-permission="@Perm.OtCreateBooking" class="btn btn-light btn-sm" href="/Ot/Book?patientId=@p.Id">Book surgery</a></div>
                <div class="table-wrap"><table class="table table-compact"><tbody>
                    @foreach (var x in surg) { <tr><td class="small nowrap">@Fmt.DateTimeText(x.PlannedStartUtc)</td><td><a href="/Ot/Surgery/@x.Id">@x.Number</a></td><td class="small">@x.ProcedureName · @x.Priority</td><td class="small"><partial name="/Pages/Ot/_SurgeryStatus.cshtml" model="x.Status" /></td></tr> }
                    @if (surg.Count == 0) { <tr><td class="empty">No surgeries.</td></tr> }
                </tbody></table></div>
            </div>
        }
        @if (Model.Radiology is { } rads)
        {
            <div class="card" data-profile-radiology>
                <div class="card-header"><h3><svg class="icon"><use href="#i-scan" /></svg> Radiology history</h3><a class="btn btn-light btn-sm" href="/Radiology/Patient/@p.Id">All</a></div>
                <div class="table-wrap"><table class="table table-compact"><tbody>
                    @foreach (var r in rads) { <tr><td class="small nowrap">@Fmt.Day(r.ScheduledDate)</td><td><a href="/Radiology/Exam/@r.Id">@r.ServiceName</a></td><td class="mono small">@r.OrderNumber</td><td class="small">@RadiologyWorkflowService.Label(r.Status)</td></tr> }
                    @if (rads.Count == 0) { <tr><td class="empty">No X-Ray / Ultrasound examinations.</td></tr> }
                </tbody></table></div>
            </div>
        }
        <div class="card">
            <div class="card-header"><h3><svg class="icon"><use href="#i-users-round" /></svg> Patient details</h3></div>
            <div class="card-body">
                <dl class="kv kv-tight">
                    <dt>Patient ID</dt><dd class="mono">@p.PatientNumber</dd>
                    <dt>Full name</dt><dd>@p.FullName</dd>
                    <dt>@(rel.Length > 0 ? rel : "Father / Husband")</dt><dd>@(p.GuardianName ?? "—")</dd>
                    <dt>Gender</dt><dd>@p.Gender</dd>
                    <dt>Age</dt><dd>@Model.AgeText</dd>
                    <dt>Date of birth</dt><dd>@(p.DateOfBirth is { } dob ? dob.ToString("dd/MM/yyyy") + (p.DateOfBirthEstimated ? " (estimated)" : "") : "—")</dd>
                    <dt>CNIC</dt><dd class="mono">@(p.Cnic ?? "—")</dd>
                    <dt>Mobile</dt><dd>@(p.MobileNumber ?? "—")</dd>
                    <dt>Alternative contact</dt><dd>@(p.AlternateContact ?? "—")</dd>
                    <dt>Address</dt><dd>@(p.Address ?? "—")</dd>
                    <dt>City / village</dt><dd>@(p.CityOrVillage ?? "—")</dd>
                    <dt>Blood group</dt><dd>@(p.BloodGroup ?? "—")</dd>
                    <dt>Registered</dt><dd>@Fmt.DateTimeText(p.RegisteredUtc)</dd>
                    @if (!string.IsNullOrEmpty(p.Notes)) { <dt>Notes</dt><dd>@p.Notes</dd> }
                </dl>
                @{ var aliases = p.Identifiers.Where(i => i.Type != PatientIdentifierType.PatientNumber).ToList(); }
                @if (aliases.Count > 0)
                {
                    <h4 class="section-title">Other identifiers</h4>
                    @foreach (var i in aliases)
                    {
                        <div class="small"><span class="tag">@(i.Type == PatientIdentifierType.MergedPatientNumber ? "Merged duplicate" : "External")</span> <span class="mono">@i.Value</span> <span class="muted">@i.Note</span></div>
                    }
                }
            </div>
        </div>
        @if (p.Status != PatientStatus.Merged)
        {
            <form bn-permission="@Perm.PatientsArchive" method="post" asp-page-handler="Archive" class="card" data-confirm="@(active ? "Archive this patient record? It is kept and can be restored." : "Restore this patient record?")">
                <div class="card-header"><h3>@(active ? "Archive record" : "Restore record")</h3></div>
                <div class="card-body">
                    <input type="hidden" name="archive" value="@(active ? "true" : "false")" />
                    <div class="field"><label for="Reason">Reason</label><input id="Reason" name="Reason" required minlength="3" maxlength="500" /></div>
                    <p class="muted small">Patient records are never deleted. Archived records are hidden from normal search.</p>
                </div>
                <div class="card-footer form-actions"><button class="btn btn-light" type="submit">@(active ? "Archive" : "Restore")</button></div>
            </form>
            <a bn-permission="@Perm.PatientsMerge" class="btn btn-light btn-block" href="/Patients/Merge/@p.Id"><svg class="icon icon-sm"><use href="#i-users" /></svg> Correct duplicate registration</a>
        }
    </div>
</div>
