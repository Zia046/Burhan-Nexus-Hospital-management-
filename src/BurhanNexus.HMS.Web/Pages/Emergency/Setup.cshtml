@page
@model BurhanNexus.HMS.Web.Pages.Emergency.SetupModel
@{
    ViewData["Title"] = "Emergency categories";
    var edit = Model.Categories.FirstOrDefault(c => c.Id == Model.EditId);
}
<div class="breadcrumbs"><a href="/Emergency">Emergency</a> <svg class="icon icon-sm"><use href="#i-chevron-right" /></svg> Categories</div>
<div class="grid-side">
    <div class="card">
        <div class="card-header"><h3>Emergency types / categories</h3></div>
        <div class="table-wrap">
            <table class="table table-compact">
                <thead><tr><th>Order</th><th>Name</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr><td>@c.SortOrder</td><td>@c.Name</td><td>@if (c.IsActive) { <span class="status status-ok">Active</span> } else { <span class="status status-off">Inactive</span> }</td>
                        <td class="actions"><a class="btn btn-light btn-xs" href="/Emergency/Setup?edit=@c.Id">Edit</a></td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <form method="post" asp-route-id="@edit?.Id" class="card">
        <div class="card-header"><h3>@(edit is null ? "Add category" : "Edit category")</h3></div>
        <div class="card-body">
            <div class="field"><label for="name">Name</label><input id="name" name="name" value="@edit?.Name" required maxlength="100" /></div>
            <div class="field"><label for="order">Display order</label><input id="order" name="sortOrder" type="number" value="@(edit?.SortOrder ?? (Model.Categories.Count + 1) * 10)" /></div>
            <label class="check"><input type="checkbox" name="isActive" value="true" checked="@(edit?.IsActive ?? true)" /> Active</label>
            <input type="hidden" name="isActive" value="false" />
        </div>
        <div class="card-footer form-actions">
            @if (edit is not null) { <a class="btn btn-light" href="/Emergency/Setup">Cancel</a> }
            <button class="btn btn-primary" type="submit">Save</button>
        </div>
    </form>
</div>
