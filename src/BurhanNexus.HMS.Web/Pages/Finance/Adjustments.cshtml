@page
@model BurhanNexus.HMS.Web.Pages.Finance.AdjustmentsModel
@{
    ViewData["Title"] = "Financial adjustments";
    var me = User.GetUserId();
}
<partial name="_FinanceNav" />
<partial name="_ValidationSummary" />
<div class="grid-side">
    <div class="card">
        <div class="card-header"><h2><svg class="icon"><use href="#i-edit" /></svg> Adjustments</h2></div>
        <div class="table-wrap">
            <table class="table table-compact" data-adjustments>
                <thead><tr><th>No.</th><th>Date</th><th>Account</th><th class="num">Amount</th><th>Reason</th><th>By</th></tr></thead>
                <tbody>
                @foreach (var a in Model.History)
                {
                    <tr><td class="mono">@a.AdjustmentNumber</td><td>@Fmt.Day(a.BusinessDate)</td>
                        <td>@(a.Target == AdjustmentTarget.Cashier ? "Cashier " + (Model.Cashiers.FirstOrDefault(c => c.UserId == a.UserId)?.FullName ?? a.UserId.ToString()) : "Doctor " + Model.Doctors.FirstOrDefault(d => d.Id == a.DoctorId)?.Name)</td>
                        <td class="num @(a.Amount < 0 ? "text-danger" : "")">@Fmt.Money(a.Amount)</td><td>@a.Reason</td><td>@a.CreatedByUsername</td></tr>
                }
                @if (Model.History.Count == 0) { <tr><td colspan="6" class="empty">No adjustments.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
    <form method="post" class="card" novalidate>
        <div class="card-header"><h3>Record adjustment</h3></div>
        <div class="card-body">
            <div class="field"><label for="Account">Cashier / doctor account</label>
                <select id="Account" name="Account" required>
                    <option value="">– select –</option>
                    <optgroup label="Cashiers">@foreach (var c in Model.Cashiers.Where(c => c.UserId != me)) { <option value="C:@c.UserId">@c.FullName (outstanding @c.Outstanding.ToString("N2"))</option> }</optgroup>
                    <optgroup label="Doctors">@foreach (var d in Model.Doctors) { <option value="D:@d.Id">@d.Name</option> }</optgroup>
                </select></div>
            <div class="field"><label for="Amount">Amount <em>*</em></label><input id="Amount" name="Amount" type="number" step="0.01" required /></div>
            <small class="muted block">Negative reduces the balance (cashier owes less / doctor is owed less); positive increases it.</small>
            <div class="field"><label for="Reason">Reason <em>*</em></label><input id="Reason" name="Reason" maxlength="300" required /></div>
            <small class="muted">You cannot adjust your own account. Every adjustment is permanent and audited.</small>
        </div>
        <div class="card-footer"><button class="btn btn-primary" type="submit" data-once>Record adjustment</button></div>
    </form>
</div>
