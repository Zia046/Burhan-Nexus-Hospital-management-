@page "{id:long}"
@model BurhanNexus.HMS.Web.Pages.Finance.StatementModel
@{
    var p = Model.Patient;
    ViewData["Title"] = "Statement " + p.PatientNumber;
    var active = Model.Charges.Where(c => c.Status != ChargeStatus.Cancelled).ToList();
}
<div class="page-header">
    <div><h1>Account statement</h1><p class="muted">@p.FullName · @p.PatientNumber</p></div>
    <button type="button" class="btn btn-light" data-print-now>Print</button>
</div>
<div class="kpis" data-statement-kpis>
    <div class="kpi"><small>Total billed</small><strong>@Fmt.Money(active.Sum(c => c.NetAmount))</strong></div>
    <div class="kpi"><small>Paid</small><strong>@Fmt.Money(active.Sum(c => c.PaidAmount))</strong></div>
    <div class="kpi"><small>Outstanding</small><strong data-outstanding>@Fmt.Money(active.Sum(c => c.NetAmount - c.PaidAmount))</strong></div>
    <div class="kpi"><small>Unused advance</small><strong>@Fmt.Money(Model.Advances.Sum(a => a.Available))</strong></div>
</div>
@foreach (var g in active.GroupBy(c => c.IpdAdmissionId))
{
    <div class="card" data-statement-group="@(g.Key is long k ? Model.Admissions.GetValueOrDefault(k) : "OPD / other")">
        <div class="card-header"><h3>@(g.Key is long a ? "Admission " + Model.Admissions.GetValueOrDefault(a) : "OPD, laboratory, radiology and other visits")</h3>
            @if (g.Key is long aid) { <a class="btn btn-light btn-sm" href="/Ipd/Account/@aid">Admission account</a> }</div>
        <table class="table table-compact">
            <thead><tr><th>Date</th><th>Charge</th><th>Service</th><th>Department</th><th class="num">Qty</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th></tr></thead>
            <tbody>@foreach (var c in g) { <tr><td>@Fmt.Day(c.BusinessDate)</td><td class="mono">@c.ChargeNumber</td><td>@c.ServiceName</td><td>@c.Department?.Name</td><td class="num">@c.Quantity.ToString("0.##")</td><td class="num">@Fmt.Money(c.NetAmount)</td><td class="num">@Fmt.Money(c.PaidAmount)</td><td class="num">@Fmt.Money(c.NetAmount - c.PaidAmount)</td></tr> }</tbody>
            <tfoot><tr><th colspan="5">Total</th><th class="num">@Fmt.Money(g.Sum(c => c.NetAmount))</th><th class="num">@Fmt.Money(g.Sum(c => c.PaidAmount))</th><th class="num">@Fmt.Money(g.Sum(c => c.NetAmount - c.PaidAmount))</th></tr></tfoot>
        </table>
    </div>
}
<div class="card">
    <div class="card-header"><h3>Receipts &amp; advances</h3></div>
    <table class="table table-compact">
        <thead><tr><th>Date</th><th>Number</th><th>Type</th><th>Method</th><th class="num">Amount</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Receipts) { <tr><td>@Fmt.DateTimeText(r.CreatedUtc)</td><td class="mono">@r.ReceiptNumber</td><td>Receipt</td><td>@r.PaymentMethod?.Name</td><td class="num">@Fmt.Money(r.AmountPaid)</td><td>@r.Status</td></tr> }
        @foreach (var a in Model.Advances) { <tr><td>@Fmt.DateTimeText(a.CreatedUtc)</td><td class="mono">@a.Number</td><td>Advance</td><td></td><td class="num">@Fmt.Money(a.Amount)</td><td>unused @Fmt.Money(a.Available)</td></tr> }
        </tbody>
    </table>
</div>
