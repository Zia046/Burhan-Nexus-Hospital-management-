@page
@model BurhanNexus.HMS.Web.Pages.Finance.CollectModel
@{
    ViewData["Title"] = "Collect payment";
    var p = Model.Patient;
    var slots = BurhanNexus.HMS.Web.Pages.Finance.CollectModel.LineSlots;
    var lines = Model.Lines.Concat(Enumerable.Range(0, slots).Select(_ => new NewChargeLine())).Take(slots).ToList();
    var choosePatient = p is null && !Model.WalkIn;
}
<partial name="_FinanceNav" />
@if (Model.NotAssigned)
{
    <div class="alert alert-warning"><svg class="icon"><use href="#i-info" /></svg><div>You are not assigned to any counter. Ask the administrator to assign you to a counter before collecting payments.</div></div>
}
@if (choosePatient)
{
    <div class="card card-medium">
        <div class="card-header"><h2><svg class="icon"><use href="#i-wallet" /></svg> Collect payment – find the patient</h2></div>
        <div class="card-body">
            <form method="get" class="search-main">
                <div class="input-icon grow"><svg class="icon"><use href="#i-search" /></svg>
                    <input name="q" value="@Model.Q" placeholder="Patient ID, name, mobile or CNIC" autofocus autocomplete="off" maxlength="100" /></div>
                <button class="btn btn-primary" type="submit">Search</button>
                <a class="btn btn-light" href="/Finance/Collect?walkIn=true">Walk-in (no registration)</a>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <div class="table-wrap">
                    <table class="table table-compact">
                        <thead><tr><th>Patient ID</th><th>Name</th><th>Father / Husband</th><th>Age</th><th>Mobile</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.Matches)
                        {
                            <tr><td class="mono">@m.PatientNumber</td><td><strong>@m.FullName</strong></td><td>@m.GuardianName</td><td>@m.AgeText</td><td>@m.MobileNumber</td>
                                <td class="actions"><a class="btn btn-primary btn-sm" href="/Finance/Collect?patientId=@m.Id">Select</a></td></tr>
                        }
                        @if (Model.Matches.Count == 0) { <tr><td colspan="6" class="empty">No patient found.</td></tr> }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <form method="post" class="grid-side" novalidate data-collect-form>
        <input type="hidden" name="Input.IdempotencyKey" value="@Model.Input.IdempotencyKey" />
        <input type="hidden" name="PatientId" value="@Model.PatientId" />
        <input type="hidden" name="EncounterId" value="@Model.EncounterId" />
        <input type="hidden" name="WalkIn" value="@(Model.WalkIn ? "true" : "false")" />
        <div class="stack">
            <div class="card">
                <div class="card-header"><h2><svg class="icon"><use href="#i-wallet" /></svg> Collect payment</h2>
                    @if (Model.Encounter is not null) { <span class="pill pill-blue">Visit @Model.Encounter.EncounterNumber</span> }</div>
                <div class="card-body">
                    <partial name="_ValidationSummary" />
                    @if (Model.EncounterCharges.Any(c => c.Status != ChargeStatus.Cancelled))
                    {
                        <div class="alert alert-info"><svg class="icon"><use href="#i-info" /></svg><div>This visit is already billed: @string.Join(", ", Model.EncounterCharges.Where(c => c.Status != ChargeStatus.Cancelled).Select(c => $"{c.ServiceName} ({c.Status})")).</div></div>
                    }
                    @if (p is null)
                    {
                        <div class="field"><label for="Input_PayerName">Payer name (walk-in) <em>*</em></label>
                            <input id="Input_PayerName" name="Input.PayerName" value="@Model.Input.PayerName" maxlength="150" required /></div>
                    }
                    <div class="grid-2">
                        <div class="field">
                            <label for="Input_CounterId">Counter <em>*</em></label>
                            <select id="Input_CounterId" name="Input.CounterId" required>
                                @if (Model.Counters.Count != 1) { <option value="">– select –</option> }
                                @foreach (var c in Model.Counters) { <option value="@c.Id" selected="@(Model.Input.CounterId == c.Id)">@c.Name</option> }
                            </select>
                        </div>
                        <div class="field">
                            <label for="Input_PaymentMethodId">Payment method <em>*</em></label>
                            <select id="Input_PaymentMethodId" name="Input.PaymentMethodId" required data-method>
                                @foreach (var m in Model.Methods) { <option value="@m.Id" data-ref="@(m.RequiresReference ? "1" : "0")" selected="@(Model.Input.PaymentMethodId == m.Id)">@m.Name</option> }
                            </select>
                        </div>
                    </div>
                    <h3 class="section-title">Services</h3>
                    <div class="table-wrap">
                        <table class="table table-compact collect-lines" data-lines>
                            <thead><tr><th>Service</th><th>Doctor</th><th class="num">Fee</th>@if (Model.CanDiscount) { <th class="num">Discount</th><th>Discount reason</th> }<th class="num">Pay now</th></tr></thead>
                            <tbody>
                            @for (var i = 0; i < lines.Count; i++)
                            {
                                var l = lines[i];
                                <tr data-line class="@(i > 0 && l.ServiceItemId == 0 ? "line-hidden" : "")">
                                    <td>
                                        <input type="hidden" name="Lines[@i].EncounterId" value="@l.EncounterId" />
                                        <select name="Lines[@i].ServiceItemId" data-service aria-label="Service">
                                            <option value="0">– service –</option>
                                            @foreach (var g in Model.Services.GroupBy(s => s.Item.Kind))
                                            {
                                                <optgroup label="@g.Key">
                                                    @foreach (var s in g)
                                                    {
                                                        <option value="@s.Item.Id" data-fee="@s.CurrentFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-partial="@(s.Item.AllowPartialPayment ? "1" : "0")"
                                                                data-doctor="@s.Item.DoctorId" data-consult="@(s.Item.Kind == ServiceKind.Consultation ? "1" : "0")" selected="@(l.ServiceItemId == s.Item.Id)">@s.Item.Name (@(s.CurrentFee == 0 ? "Free" : Fmt.Money(s.CurrentFee)))</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select name="Lines[@i].DoctorId" data-doctor aria-label="Doctor">
                                            <option value="">—</option>
                                            @foreach (var d in Model.Doctors) { <option value="@d.Id" selected="@(l.DoctorId == d.Id)">@d.Name</option> }
                                        </select>
                                    </td>
                                    <td class="num" data-fee-cell>—</td>
                                    @if (Model.CanDiscount)
                                    {
                                        <td><input name="Lines[@i].Discount" type="number" step="0.01" min="0" value="@(l.Discount == 0 ? "" : l.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-discount class="input-num" aria-label="Discount" /></td>
                                        <td><input name="Lines[@i].DiscountReason" value="@l.DiscountReason" maxlength="200" aria-label="Discount reason" /></td>
                                    }
                                    <td><input name="Lines[@i].PayNow" type="number" step="0.01" min="0" value="@(l.PayNow?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-paynow class="input-num" aria-label="Pay now" placeholder="full" /></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-light btn-sm no-js-hide" data-add-line><svg class="icon icon-sm"><use href="#i-plus" /></svg> Add service</button>
                    <small class="muted block">"Pay now" empty = full amount. Partial payment only for services that allow it; the balance can be paid later with a new receipt.</small>

                    @if (Model.OpenCharges.Count > 0)
                    {
                        <h3 class="section-title">Outstanding balances</h3>
                        <div class="table-wrap">
                            <table class="table table-compact" data-open-charges>
                                <thead><tr><th>Charge</th><th>Date</th><th>Service</th><th class="num">Net</th><th class="num">Paid</th><th class="num">Balance</th><th class="num">Pay now</th></tr></thead>
                                <tbody>
                                @for (var i = 0; i < Model.OpenCharges.Count; i++)
                                {
                                    var c = Model.OpenCharges[i];
                                    <tr><td class="mono">@c.ChargeNumber<input type="hidden" name="Balances[@i].ChargeId" value="@c.Id" /></td><td>@Fmt.Day(c.BusinessDate)</td><td>@c.ServiceName @(c.DoctorName is null ? "" : "– " + c.DoctorName)</td>
                                        <td class="num">@Fmt.Money(c.NetAmount)</td><td class="num">@Fmt.Money(c.PaidAmount)</td><td class="num"><strong>@Fmt.Money(c.Balance)</strong></td>
                                        <td><input name="Balances[@i].PayNow" type="number" step="0.01" min="0" max="@c.Balance" class="input-num" data-balance-pay aria-label="Pay now" /></td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="grid-2">
                        <div class="field" data-ref-field><label for="Input_PaymentReference">Payment reference <span class="muted">(bank / card)</span></label>
                            <input id="Input_PaymentReference" name="Input.PaymentReference" value="@Model.Input.PaymentReference" maxlength="100" /></div>
                        <div class="field"><label for="Input_Notes">Notes</label><input id="Input_Notes" name="Input.Notes" value="@Model.Input.Notes" maxlength="300" /></div>
                    </div>
                </div>
                <div class="card-footer form-actions">
                    <span class="collect-total">Total now: <strong data-total>—</strong></span>
                    <a class="btn btn-light" href="/Finance/Collect">Change patient</a>
                    <button class="btn btn-primary btn-lg" type="submit" data-test="collect-save" data-once disabled="@Model.NotAssigned"><svg class="icon icon-sm"><use href="#i-printer" /></svg> Save &amp; print receipt</button>
                </div>
            </div>
        </div>
        <div class="stack">
            @if (p is not null)
            {
                <div class="card patient-mini"><div class="card-body">
                    <div class="patient-id-box sm"><small>Patient ID</small><strong>@p.PatientNumber</strong></div>
                    <h3>@p.FullName</h3>
                    <dl class="kv kv-tight"><dt>Age / Gender</dt><dd>@Model.AgeText · @p.Gender</dd><dt>Mobile</dt><dd>@(p.MobileNumber ?? "—")</dd></dl>
                    <a bn-permission="@Perm.PatientsView" href="/Patients/Profile/@p.Id">Open profile</a> ·
                    <a bn-permission="@Perm.FinanceViewOwnReceipts" href="/Finance/Receipts?patientId=@p.Id">Receipts</a>
                </div></div>
            }
            else
            {
                <div class="card"><div class="card-body"><strong>Walk-in payment</strong><p class="muted">No patient registration. Use for e.g. a laboratory test of an unregistered person.</p></div></div>
            }
        </div>
    </form>
}
