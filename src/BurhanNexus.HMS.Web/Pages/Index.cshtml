@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var profile = await Fmt.ProfileAsync();
    var hour = Fmt.ToLocal(DateTime.UtcNow).Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}
<section class="welcome">
    <img class="welcome-logo" src="/branding/logo?v=@(profile?.LogoVersion ?? 0)" alt="Logo" />
    <div class="welcome-text">
        <h2>@greeting, @User.GetFullName()</h2>
        <p>@profile?.HospitalName · <span data-clock-text-long>@Fmt.Date(DateTime.UtcNow)</span></p>
    </div>
    @if (profile is not null)
    {
        <span class="pill @(profile.HospitalType == HospitalType.Government ? "pill-navy" : "pill-blue")">@profile.HospitalType Hospital</span>
    }
</section>

@if (!Model.ShowDashboard)
{
    <div class="card"><div class="card-body">
        <p>Welcome to @profile?.HospitalName. Your administrator has not given you dashboard access yet. Use the menu on the left to open the sections assigned to you.</p>
    </div></div>
}
else
{
    @if (Model.Clinical is { } cl)
    {
        <div class="kpi-grid clinical-kpis">
            @if (Model.Perms.Contains(Perm.PatientsSearch))
            {
                <a class="kpi kpi-link" href="/Patients"><div class="kpi-icon blue"><svg class="icon"><use href="#i-users-round" /></svg></div><div><span class="kpi-label">Registered today</span><strong class="kpi-value" data-kpi="registered">@cl.RegisteredToday</strong></div></a>
            }
            @if (Model.Perms.Contains(Perm.OpdView))
            {
                <a class="kpi kpi-link" href="/Opd"><div class="kpi-icon navy"><svg class="icon"><use href="#i-stethoscope" /></svg></div><div><span class="kpi-label">OPD visits today</span><strong class="kpi-value" data-kpi="opd">@cl.OpdToday</strong></div></a>
            }
            @if (Model.Perms.Contains(Perm.EmergencyView))
            {
                <a class="kpi kpi-link" href="/Emergency?status=all"><div class="kpi-icon red"><svg class="icon"><use href="#i-siren" /></svg></div><div><span class="kpi-label">Emergency today</span><strong class="kpi-value" data-kpi="er">@cl.EmergencyToday</strong></div></a>
                <a class="kpi kpi-link" href="/Emergency"><div class="kpi-icon red"><svg class="icon"><use href="#i-activity" /></svg></div><div><span class="kpi-label">Active emergencies</span><strong class="kpi-value" data-kpi="er-active">@cl.EmergencyActive</strong></div></a>
            }
        </div>
    }
    @if (Model.DoctorsToday is { } docs)
    {
        <div class="card" data-dashboard-appointments>
            <div class="card-header"><h3><svg class="icon"><use href="#i-calendar" /></svg> Today's appointments by doctor</h3>
                <a class="btn btn-light btn-sm" href="/Appointments">Open lists</a></div>
            <div class="table-wrap">
                <table class="table table-compact">
                    <thead><tr><th>Doctor</th><th>Specialization</th><th class="num">Waiting</th><th class="num">Seen</th><th class="num">Cancelled</th><th class="num">Total</th></tr></thead>
                    <tbody>
                    @foreach (var d in docs)
                    {
                        <tr><td><a href="/Appointments?doctor=@d.DoctorId"><strong>@d.DoctorName</strong></a></td><td>@d.Specialty</td><td class="num">@d.Booked</td><td class="num">@d.Seen</td><td class="num">@d.Cancelled</td><td class="num"><strong>@d.Active</strong></td></tr>
                    }
                    @if (docs.Count == 0) { <tr><td colspan="6" class="empty">No appointments booked today yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (Model.UserCounts is not null || Model.License is not null || Model.Health is not null)
    {
        <div class="kpi-grid" data-dashboard-live>
            @if (Model.UserCounts is { } c)
            {
                <div class="kpi"><div class="kpi-icon blue"><svg class="icon"><use href="#i-users" /></svg></div><div><span class="kpi-label">Registered users</span><strong class="kpi-value" data-live="users.total">@c.Total</strong></div></div>
                <div class="kpi"><div class="kpi-icon green"><svg class="icon"><use href="#i-check-circle" /></svg></div><div><span class="kpi-label">Active users</span><strong class="kpi-value" data-live="users.active">@c.Active</strong></div></div>
                <div class="kpi"><div class="kpi-icon grey"><svg class="icon"><use href="#i-x" /></svg></div><div><span class="kpi-label">Inactive users</span><strong class="kpi-value" data-live="users.inactive">@c.Inactive</strong></div></div>
            }
            @if (Model.License is { } l)
            {
                <a class="kpi kpi-link" href="/Settings/License"><div class="kpi-icon @(l.AllowsWrite ? "navy" : "red")"><svg class="icon"><use href="#i-key" /></svg></div><div><span class="kpi-label">License</span><strong class="kpi-value kpi-small" data-live="license.name">@l.DisplayName</strong>@if (l.DaysRemaining is int d) { <small class="muted"><span data-live="license.daysRemaining">@d</span> days remaining</small> }</div></a>
            }
            @if (Model.Health is { } h)
            {
                <div class="kpi"><div class="kpi-icon @(h.DatabaseConnected ? "green" : "red")"><svg class="icon"><use href="#i-database" /></svg></div><div><span class="kpi-label">Database</span><strong class="kpi-value kpi-small"><span class="dot @(h.DatabaseConnected ? "dot-ok" : "dot-bad")" data-live-dot="system.database"></span> @(h.DatabaseConnected ? "Connected" : "Unavailable")</strong><small class="muted">PostgreSQL @(h.DatabaseVersion?.Split(' ')[0])</small></div></div>
                <div class="kpi"><div class="kpi-icon blue"><svg class="icon"><use href="#i-server" /></svg></div><div><span class="kpi-label">Server</span><strong class="kpi-value kpi-small"><span class="dot dot-ok" data-server-dot></span> <span data-server-text>Online</span></strong><small class="muted"><span data-live="system.activeSessions">@h.ActiveSessions</span> active session(s)</small></div></div>
            }
        </div>
    }

    <div class="dash-grid">
        <div class="dash-col">
            @{
                var quick = new List<(string Perm, string Url, string Icon, string Title, string Text)>
                {
                    (Perm.UsersView, "/Users", "i-users", "User Management", "Create users, departments and accounts"),
                    (Perm.UsersAssignPermissions, "/Users", "i-shield", "Permissions", "Assign responsibilities and access"),
                    (Perm.SettingsView, "/Settings", "i-settings", "Hospital Settings", "Branding, printing and preferences"),
                    (Perm.BackupView, "/Backup", "i-database", "Backup & Restore", "Protect the hospital database"),
                    (Perm.AuditView, "/Audit", "i-activity", "Audit Log", "Review system activity"),
                    (Perm.LicenseView, "/Settings/License", "i-key", "License", "Licence status and activation"),
                };
                var visibleQuick = quick.Where(q => Model.Perms.Contains(q.Perm)).ToList();
            }
            @if (visibleQuick.Count > 0)
            {
                <div class="card">
                    <div class="card-header"><h3>Quick access</h3></div>
                    <div class="card-body quick-grid">
                        @foreach (var q in visibleQuick)
                        {
                            <a class="quick" href="@q.Url"><svg class="icon"><use href="#@q.Icon" /></svg><span><strong>@q.Title</strong><small>@q.Text</small></span></a>
                        }
                    </div>
                </div>
            }

            @if (Model.Configuration is { } cfg && profile is not null)
            {
                <div class="card">
                    <div class="card-header"><h3>Hospital configuration</h3><a bn-permission="@Perm.SettingsView" class="btn btn-light btn-sm" href="/Settings">Open settings</a></div>
                    <div class="card-body">
                        <dl class="kv">
                            <dt>Hospital type</dt><dd>@cfg.HospitalType</dd>
                            <dt>Location</dt><dd>@profile.City, @profile.Province</dd>
                            <dt>Currency</dt><dd>@cfg.CurrencyCode (@cfg.CurrencySymbol)</dd>
                            <dt>Time zone</dt><dd>@cfg.TimeZoneId</dd>
                            <dt>Date / time format</dt><dd>@cfg.DateFormat · @cfg.TimeFormat</dd>
                            <dt>Pharmacy pricing</dt><dd>@(cfg.PharmacyPricingEnabled ? "Enabled (purchase & sale prices)" : "Disabled (government stock)")</dd>
                            <dt>Setup completed</dt><dd>@Fmt.DateTimeText(cfg.SetupCompletedUtc)</dd>
                            @if (!string.IsNullOrEmpty(Model.ServerAddresses))
                            {
                                <dt>Connect other computers</dt><dd class="mono">@Model.ServerAddresses</dd>
                            }
                        </dl>
                    </div>
                </div>
            }
        </div>

        <div class="dash-col">
            @if (Model.Perms.Contains(Perm.AuditView))
            {
                <div class="card">
                    <div class="card-header"><h3>Recent system activity</h3><a class="btn btn-light btn-sm" href="/Audit">View all</a></div>
                    <ul class="activity">
                        @foreach (var a in Model.Recent)
                        {
                            <li class="@(a.Success ? "" : "failed")">
                                <span class="activity-dot"></span>
                                <div>
                                    <strong>@a.Description</strong>
                                    <small>@(a.Username ?? "System") · @Fmt.DateTimeText(a.TimestampUtc)@(a.Workstation is null ? "" : " · " + a.Workstation)</small>
                                </div>
                            </li>
                        }
                        @if (Model.Recent.Count == 0) { <li class="muted">No activity yet.</li> }
                    </ul>
                </div>
            }
        </div>
    </div>
}

@if (Model.UpcomingModules.Count > 0 || Model.AvailableModules.Count > 0)
{
    <h3 class="section-title">Hospital modules</h3>
    <div class="module-grid">
        @foreach (var m in Model.AvailableModules)
        {
            var link = m.Key switch
            {
                "Patients" => Model.Perms.Contains(Perm.PatientsSearch) ? "/Patients" : Model.Perms.Contains(Perm.PatientsAdd) ? "/Patients/Register" : null,
                "Opd" => Model.Perms.Contains(Perm.OpdView) ? "/Opd" : "/Opd/Register",
                "Laboratory" => Model.Perms.Contains(Perm.LabDashboard) ? "/Lab" : Model.Perms.Contains(Perm.LabBook) ? "/Lab/Book"
                    : Model.Perms.Contains(Perm.LabEnterResults) ? "/Lab/Pending" : "/Lab/Results",
                _ => Model.Perms.Contains(Perm.EmergencyView) ? "/Emergency" : "/Emergency/Register"
            };
            <a class="module-card available" href="@(link ?? "#")">
                <svg class="icon icon-lg"><use href="#i-@m.Icon" /></svg>
                <strong>@m.Name</strong>
                <small>@m.Description</small>
                <span class="badge badge-ok">Open</span>
            </a>
        }
        @foreach (var m in Model.UpcomingModules)
        {
            <div class="module-card upcoming" aria-disabled="true" title="This module will be available in a future update">
                <svg class="icon icon-lg"><use href="#i-@m.Icon" /></svg>
                <strong>@m.Name</strong>
                <small>@m.Description</small>
                <span class="badge badge-soon">Coming in a future phase</span>
            </div>
        }
    </div>
}
