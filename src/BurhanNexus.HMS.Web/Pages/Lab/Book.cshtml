@page
@model BurhanNexus.HMS.Web.Pages.Lab.BookModel
@{
    ViewData["Title"] = "New laboratory visit";
    var p = Model.Patient;
}
<partial name="_LabNav" />
@if (p is null)
{
    <div class="card card-medium">
        <div class="card-header"><h2><svg class="icon"><use href="#i-flask" /></svg> New laboratory visit – find the patient</h2></div>
        <div class="card-body">
            <form method="get" class="search-main" data-patient-suggest-form>
                <div class="input-icon grow patient-suggest"><svg class="icon"><use href="#i-search" /></svg>
                    <input name="q" value="@Model.Q" placeholder="Type the patient's name (today's patients) – or Patient ID / phone" autofocus autocomplete="off" maxlength="100"
                           data-patient-suggest="/Lab/Book?handler=Suggest" data-pick-url="/Lab/Book?patientId=" aria-label="Patient" />
                    <div class="suggest-list" data-suggest-list hidden></div></div>
                <button class="btn btn-primary" type="submit">Search</button>
                @if (Model.CanRegister) { <a class="btn btn-success" href="/Patients/Register?next=lab@(string.IsNullOrWhiteSpace(Model.Q) ? "" : "&name=" + Uri.EscapeDataString(Model.Q))"><svg class="icon icon-sm"><use href="#i-plus" /></svg> New patient</a> }
            </form>
            @if (string.IsNullOrWhiteSpace(Model.Q))
            {
                <h3 class="section-title">Today's OPD patients</h3>
                <div class="today-patients" data-today-opd>
                    @foreach (var t in Model.TodayOpd)
                    {
                        <a class="today-patient" href="/Lab/Book?patientId=@t.Id" data-today-patient="@t.Number"><strong>@t.Name</strong><small class="mono">@t.Number</small></a>
                    }
                    @if (Model.TodayOpd.Count == 0) { <p class="muted small">No OPD patient today yet – type a name above, or register a new patient.</p> }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Q))
            {
                <div class="table-wrap">
                    <table class="table table-compact" data-matches>
                        <thead><tr><th>Patient ID</th><th>Name</th><th>Father / Husband</th><th>Age</th><th>Phone</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var m in Model.Matches)
                        {
                            <tr><td class="mono">@m.PatientNumber</td><td><strong>@m.FullName</strong></td><td>@m.GuardianName</td><td>@m.AgeText · @m.Gender</td><td>@m.MobileNumber</td>
                                <td class="actions"><a class="btn btn-primary btn-sm" href="/Lab/Book?patientId=@m.Id">Select</a>
                                    <a bn-permission="@Perm.LabViewPrevious" class="btn btn-light btn-sm" href="/Lab/Patient/@m.Id">Lab history</a></td></tr>
                        }
                        @if (Model.Matches.Count == 0) { <tr><td colspan="6" class="empty">No patient of today found (only today's and admitted patients are listed here). A returning patient: open him in <a href="/Patients">Patients</a> – or register a new patient.</td></tr> }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <form method="post" class="grid-side" novalidate data-lab-book>
        <input type="hidden" name="Input.IdempotencyKey" value="@Model.Input.IdempotencyKey" />
        <input type="hidden" name="PatientId" value="@p.Id" />
        <input type="hidden" name="EncounterId" value="@Model.EncounterId" />
        <input type="hidden" name="AdmissionId" value="@Model.AdmissionId" />
        <div class="card">
            <div class="card-header"><h2><svg class="icon"><use href="#i-flask" /></svg> Select tests</h2><span class="pill pill-blue" data-selected-count>0 selected</span></div>
            <div class="card-body">
                <partial name="_ValidationSummary" />
                @if (Model.Tests.Count == 0) { <div class="alert alert-warning"><svg class="icon"><use href="#i-info" /></svg><div>No active tests. Activate tests in the <a href="/Lab/Catalogue">test catalogue</a>.</div></div> }
                <div class="input-icon"><svg class="icon"><use href="#i-search" /></svg><input type="search" placeholder="Search any test by name or code…" data-test-filter aria-label="Search tests" autofocus /></div>
                <div class="selected-tests" data-selected-list hidden><strong>Selected:</strong> <span data-selected-names></span></div>
                <h3 class="section-title" data-frequent-title>Frequently used</h3>
                <p class="small muted" data-search-hint hidden>Search results</p>
                @{ var freq = Model.Frequent.ToList(); }
                <div class="test-picker" data-test-list>
                    @foreach (var t in Model.Tests.OrderBy(t => freq.IndexOf(t.Test.Id) is var ix && ix >= 0 ? ix : 999).ThenBy(t => t.Test.Name))
                    {
                        <label class="test-choice" data-test-name="@t.Test.Name.ToLowerInvariant() @t.Test.Code.ToLowerInvariant()" data-frequent="@(freq.Contains(t.Test.Id) ? "1" : null)" data-rank="@(freq.IndexOf(t.Test.Id) is var ix && ix >= 0 ? ix : 999)">
                                <input type="checkbox" name="TestIds" value="@t.Test.Id" checked="@Model.TestIds.Contains(t.Test.Id)" data-price="@t.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                <span><strong>@t.Test.Name</strong> <small class="muted">@t.Test.Code · @t.Test.SampleType!.Name</small>
                                    @if (Model.ShowFees) { <small class="block">@Fmt.Fee(t.Price, t.Test.ServiceItem?.IsFree ?? false)</small> }</span>
                            </label>
                    }
                </div>
                <p class="small muted" data-no-match hidden>No test matches the search.</p>
                @* Update 13: payment directly below the suggested tests (same method as before). *@
                @* Update 14: one discount for the whole visit; cash received is a separate box. *@
                @if (Model.ShowFees)
                {
                <fieldset class="fee-box" data-lab-charges>
                    <legend>Charges</legend>
                    <div class="grid-2">
                        <div class="field"><label>Total amount</label><div class="input-static"><strong data-lab-gross>0.00</strong></div></div>
                        @if (Model.CanDiscount)
                        {
                            <div class="field"><label for="Input_TotalDiscount">Discount</label>
                                <input id="Input_TotalDiscount" name="Input.TotalDiscount" type="number" step="0.01" min="0" inputmode="decimal" placeholder="0" data-lab-discount value="@Model.Input.TotalDiscount?.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div>
                            <div class="field"><label for="Input_DiscountReason">Discount reason <span class="muted">(optional)</span></label><input id="Input_DiscountReason" name="Input.DiscountReason" value="@Model.Input.DiscountReason" maxlength="200" /></div>
                        }
                        <div class="field"><label>Net payable</label><div class="input-static"><strong data-lab-net data-test="lab-net">0.00</strong></div></div>
                    </div>
                    <p class="small muted" data-lab-discount-error hidden>The discount cannot be more than the total.</p>
                </fieldset>
                }
                @if (Model.CanCollect)
            {
                <fieldset class="fee-box" data-lab-payment>
                    <legend>Payment</legend>
                    <div class="grid-2">
                        <div class="field"><label for="Input_PaymentMethodId">Payment method</label><select id="Input_PaymentMethodId" name="Input.PaymentMethodId">
                            @foreach (var m in Model.Methods) { <option value="@m.Id" selected="@(Model.Input.PaymentMethodId == m.Id || (Model.Input.PaymentMethodId is null && m.Code == "CASH"))">@m.Name</option> }</select></div>
                        <div class="field"><label for="Input_AmountReceived">Cash received <span class="muted">(empty = net payable)</span></label>
                            <input id="Input_AmountReceived" name="Input.AmountReceived" type="number" step="0.01" min="0" inputmode="decimal" data-lab-received value="@Model.Input.AmountReceived?.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></div>
                        @if (Model.Counters.Count > 1)
                        {
                            <div class="field"><label for="Input_CounterId">Counter</label><select id="Input_CounterId" name="Input.CounterId">
                                @foreach (var c in Model.Counters) { <option value="@c.Id" selected="@(Model.Input.CounterId == c.Id)">@c.Name</option> }</select></div>
                        }
                        <div class="field"><label for="Input_PaymentReference">Reference <span class="muted">(card / bank)</span></label><input id="Input_PaymentReference" name="Input.PaymentReference" value="@Model.Input.PaymentReference" maxlength="100" /></div>
                    </div>
                    @if (Model.Counters.Count == 0) { <div class="alert alert-warning"><svg class="icon"><use href="#i-info" /></svg><div>You are not assigned to a cash counter – the payment cannot be recorded here.</div></div> }
                </fieldset>
                }
                <h3 class="section-title">Referral &amp; notes</h3>
                <div class="grid-2">
                    <div class="field"><label for="Input_ReferralType">Referred by</label>
                        <select id="Input_ReferralType" name="Input.ReferralType" data-referral>
                            <option value="None" selected="@(Model.Input.ReferralType == LabReferralType.None)">No referring doctor</option>
                            <option value="HospitalDoctor" selected="@(Model.Input.ReferralType == LabReferralType.HospitalDoctor)">Hospital doctor</option>
                            <option value="External" selected="@(Model.Input.ReferralType == LabReferralType.External)">External doctor</option>
                        </select></div>
                    <div class="field" data-referral-doctor><label for="Input_ReferringDoctorId">Hospital doctor</label>
                        <select id="Input_ReferringDoctorId" name="Input.ReferringDoctorId"><option value="">—</option>
                            @foreach (var d in Model.Doctors) { <option value="@d.Id" selected="@(Model.Input.ReferringDoctorId == d.Id)">@d.Name @(d.Specialty is null ? "" : "– " + d.Specialty)</option> }</select></div>
                    <div class="field" data-referral-external><label for="Input_ExternalDoctorName">External doctor</label>
                        <input id="Input_ExternalDoctorName" name="Input.ExternalDoctorName" value="@Model.Input.ExternalDoctorName" maxlength="150" placeholder="Dr. name, clinic" /></div>
                    <div class="field"><label for="Input_ClinicalNotes">Clinical notes</label><input id="Input_ClinicalNotes" name="Input.ClinicalNotes" value="@Model.Input.ClinicalNotes" maxlength="1000" /></div>
                    @if (p?.Gender == Gender.Female)
                    {
                        <label class="check" data-pregnant><input type="checkbox" name="Input.Pregnant" value="true" checked="@Model.Input.Pregnant" /> Patient is pregnant (pregnancy reference ranges are used where defined)</label>
                    }
                </div>
                <label class="check"><input type="checkbox" name="Input.IsUrgent" value="true" checked="@Model.Input.IsUrgent" /> Urgent</label>
            </div>
            <div class="card-footer form-actions">
                @if (Model.ShowFees) { <span class="collect-total">Net payable: <strong data-lab-total>0.00</strong></span> }
                <a class="btn btn-light" href="/Lab/Book">Change patient</a>
                @if (Model.CanCollect && Model.Counters.Count > 0)
                {
                    <button class="btn btn-light" type="submit" name="Input.CollectPayment" value="false" data-test="lab-book-save">Save without payment</button>
                    <button class="btn btn-primary btn-lg" type="submit" name="Input.CollectPayment" value="true" data-test="lab-book-pay" data-once>Payment received – save visit</button>
                }
                else
                {
                    <button class="btn btn-primary btn-lg" type="submit" data-test="lab-book-save" data-once>Save laboratory visit</button>
                }
            </div>
        </div>
        <div class="stack">
            <div class="card patient-mini"><div class="card-body">
                <div class="patient-id-box sm"><small>Patient ID</small><strong>@p.PatientNumber</strong></div>
                <h3>@p.FullName</h3>
                <dl class="kv kv-tight">
                    <dt>Father / Husband</dt><dd>@(p.GuardianName ?? "—")</dd>
                    <dt>Age / Gender</dt><dd>@Model.AgeText · @p.Gender</dd>
                    <dt>Phone</dt><dd>@(p.MobileNumber ?? "—")</dd>
                    <dt>Address</dt><dd>@(p.Address ?? p.CityOrVillage ?? "—")</dd>
                </dl>
                <a bn-permission="@Perm.PatientsView" href="/Patients/Profile/@p.Id">Open profile</a>
            </div></div>
            <div class="card">
                <div class="card-header"><h3>Previous lab visits</h3><a bn-permission="@Perm.LabViewPrevious" class="btn btn-light btn-sm" href="/Lab/Patient/@p.Id">All</a></div>
                <ul class="activity">
                    @foreach (var o in Model.Previous)
                    {
                        <li><span class="activity-dot"></span><div><strong><a href="/Lab/Order/@o.Id">@o.OrderNumber</a> · @Fmt.Day(o.BusinessDate)</strong><small>@string.Join(", ", o.Items.Select(i => i.TestCode)) · @o.ReportStatus</small></div></li>
                    }
                    @if (Model.Previous.Count == 0) { <li class="empty">No earlier laboratory visits.</li> }
                </ul>
            </div>
        </div>
    </form>
}
