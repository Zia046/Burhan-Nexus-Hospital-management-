@page
@model BurhanNexus.HMS.Web.Pages.Lab.PendingModel
@{ ViewData["Title"] = "Pending tests"; }
<partial name="_LabNav" />
<div class="toolbar">
    <form method="get" class="filters"><div class="input-icon"><svg class="icon"><use href="#i-search" /></svg><input name="q" value="@Model.Q" placeholder="Visit no., Patient ID, name or phone" maxlength="100" /></div><button class="btn btn-light" type="submit">Search</button></form>
</div>
<div class="card">
    <div class="card-header"><h2><svg class="icon"><use href="#i-edit" /></svg> Pending tests</h2>
        <span class="pill pill-blue" data-pending-count>@Model.Orders.Sum(o => o.Pending) test(s) · @Model.Orders.Count patient visit(s)</span></div>
    <div class="table-wrap">
        <table class="table" data-pending>
            <thead><tr><th>Visit</th><th>Patient</th><th>Pending tests</th><th>Done</th><th></th></tr></thead>
            <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr class="@(o.IsUrgent ? "row-urgent" : "")" data-order="@o.OrderNumber">
                    <td class="mono nowrap">@o.OrderNumber @if (o.IsUrgent) { <span class="status status-bad">Urgent</span> }<small class="muted block">@Fmt.DateTimeText(o.BookedUtc)</small></td>
                    <td><strong>@o.PatientName</strong><small class="muted block">@o.PatientNumber · @o.AgeGender</small></td>
                    <td>@foreach (var i in o.Items.Where(i => LabService.OpenStatuses.Contains(i.Status)))
                        {
                            <a class="chip @(i.Status == LabOrderItemStatus.SamplePending ? "chip-warn" : i.CorrectionReason is not null ? "chip-bad" : "")" href="/Lab/Entry/@o.Id?item=@i.Id" title="@LabService.Label(i.Status)@(i.CorrectionReason is null ? "" : " – " + i.CorrectionReason)" data-pending-test="@i.TestCode">@i.TestCode</a>
                        }</td>
                    <td class="nowrap">@o.Completed / @o.Active</td>
                    <td class="actions"><a class="btn btn-primary btn-sm" href="/Lab/Entry/@o.Id">Enter results</a></td>
                </tr>
            }
            @if (Model.Orders.Count == 0) { <tr><td colspan="5" class="empty">No pending tests. 🎉</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body small muted">Amber = sample not collected yet · red = sent back for correction. Tests with a saved result move to the verification queue.</div>
</div>
