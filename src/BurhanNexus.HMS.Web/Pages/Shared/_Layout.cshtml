@inject BurhanNexus.HMS.Infrastructure.Licensing.ILicenseService LicenseSvc
@inject ISettingsService SettingsSvc
@{
    var profile = await Fmt.ProfileAsync();
    var perms = await PermCtx.GetAsync();
    var license = await LicenseSvc.GetStatusAsync();
    var security = await SettingsSvc.GetSecurityAsync();
    var nav = ViewData["Nav"] as string ?? "";
    var hospitalName = profile?.HospitalName ?? "Burhan Nexus Hospital Management";
    string Active(string key) => nav == key ? "active" : "";
    bool Any(params string[] keys) => keys.Any(perms.Contains);
    var isPrivate = profile?.HospitalType == HospitalType.Private;
    // Phase 7.1: the system administrator keeps 11 pages in the sidebar; every other category moves to the top taskbar.
    var isAdmin = User.IsSystemAdministrator();
    var labSimple = (await Context.RequestServices.GetRequiredService<BurhanNexus.HMS.Infrastructure.Laboratory.ILabCatalogService>().SettingsAsync()).SimpleWorkflow;
    var menu = NavMenu.Build(perms, isPrivate, labSimple);
    var adminBar = isAdmin
        ? menu.Where(m => m.Visible).Select(m => m with { Items = m.Items.Where(i => !NavMenu.AdminSidebar.Contains(i.Nav)).ToList() }).Where(m => m.Items.Count > 0).ToList()
        : new List<NavSection>();
}
@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent NavLink(NavItem i, string cls)
    {
        var nav = ViewData["Nav"] as string ?? "";
        var active = nav == i.Nav ? " active" : "";
        var dataNav = i.EmitDataNav ? $" data-nav=\"{i.Nav}\"" : "";
        var priv = i.PrivateOnly ? " data-private-only" : "";
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a class=\"{cls}{active}\" href=\"{enc.Encode(i.Href)}\"{dataNav}{priv}><svg class=\"icon\"><use href=\"#i-{i.Icon}\" /></svg><span>{enc.Encode(i.Label)}</span></a>");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @hospitalName</title>
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app" data-session-timeout="@security.SessionTimeoutMinutes">
<partial name="_Icons" />
<aside class="sidebar" id="sidebar">
    <a class="brand" href="/">
        <img class="brand-logo" src="/branding/logo?v=@(profile?.LogoVersion ?? 0)" alt="Logo" />
        <span class="brand-text">
            <strong>@hospitalName</strong>
            <small>Burhan Nexus HMS</small>
        </span>
    </a>
    <nav class="nav" data-sidebar-nav="@(isAdmin ? "admin" : "user")">
        @if (perms.Contains(Perm.DashboardView) && !isAdmin)
        {
            <a class="nav-link @Active("dashboard")" href="/"><svg class="icon"><use href="#i-home" /></svg><span>Dashboard</span></a>
        }
        @foreach (var sec in menu.Where(m => m.Visible))
        {
            var items = isAdmin ? sec.Items.Where(i => NavMenu.AdminSidebar.Contains(i.Nav)).ToList() : sec.Items.ToList();
            if (isAdmin && items.Count == 0) { continue; }
            <div class="nav-section">@sec.Title</div>
            foreach (var item in items) { @NavLink(item, "nav-link") }
        }
    </nav>
    <div class="sidebar-footer">Burhan Nexus · v1.9 · Update 9</div>
</aside>
<div class="sidebar-backdrop" data-sidebar-close></div>

<div class="main">
    <header class="topbar">
        <button type="button" class="icon-btn sidebar-toggle" data-sidebar-toggle aria-label="Menu"><svg class="icon"><use href="#i-menu" /></svg></button>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <div class="topbar-right">
            @if (!license.AllowsWrite && license.State != BurhanNexus.HMS.Core.Licensing.LicenseState.NotInitialized)
            {
                <span class="pill pill-danger" title="@license.Message"><svg class="icon icon-sm"><use href="#i-lock" /></svg> Read-only</span>
            }
            else if (license.State == BurhanNexus.HMS.Core.Licensing.LicenseState.TrialActive && perms.Contains(Perm.LicenseView))
            {
                <span class="pill pill-warning" title="@license.Message">Trial · @license.DaysRemaining days left</span>
            }
            <span class="topbar-clock" data-clock data-tz="@(profile?.TimeZoneId ?? "Asia/Karachi")"><svg class="icon icon-sm"><use href="#i-clock" /></svg> <span data-clock-text>@Fmt.DateTimeText(DateTime.UtcNow)</span></span>
            <div class="user-menu" data-dropdown>
                <button type="button" class="user-btn" data-dropdown-toggle>
                    <span class="avatar">@(User.GetFullName().Length > 0 ? User.GetFullName()[..1].ToUpperInvariant() : "U")</span>
                    <span class="user-name">@User.GetFullName()</span>
                </button>
                <div class="dropdown">
                    <div class="dropdown-header"><strong>@User.GetFullName()</strong><small>@@@User.Identity?.Name</small></div>
                    <a href="/Account/ChangePassword"><svg class="icon icon-sm"><use href="#i-lock" /></svg> Change password</a>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit"><svg class="icon icon-sm"><use href="#i-logout" /></svg> Log out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>
    @if (isAdmin && adminBar.Count > 0)
    {
        <nav class="adm-bar" data-adm-bar aria-label="Modules">
            @if (perms.Contains(Perm.DashboardView))
            {
                <a class="adm-home @Active("dashboard")" href="/" data-adm-home><svg class="icon icon-sm"><use href="#i-home" /></svg><span>Dashboard</span></a>
            }
            @foreach (var cat in adminBar)
            {
                var catActive = cat.Items.Any(i => i.Nav == nav);
                <details class="adm-cat @(catActive ? "active" : "")" data-adm-cat="@cat.Key">
                    <summary><svg class="icon icon-sm"><use href="#i-@cat.Icon" /></svg><span>@cat.Title</span><svg class="icon icon-xs adm-caret"><use href="#i-chevron-down" /></svg></summary>
                    <div class="adm-menu" role="menu">
                        <div class="adm-menu-title">@cat.Title</div>
                        @foreach (var item in cat.Items) { @NavLink(item, "adm-link") }
                    </div>
                </details>
            }
        </nav>
    }
    <main class="content">
        <partial name="_Flash" />
        @RenderBody()
    </main>
</div>

<div class="modal-backdrop" id="session-warning" hidden>
    <div class="modal">
        <h3><svg class="icon"><use href="#i-clock" /></svg> Session about to expire</h3>
        <p>You have been inactive. For security you will be logged out in <strong data-session-countdown>60</strong> seconds.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" data-session-continue>Stay logged in</button>
        </div>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
