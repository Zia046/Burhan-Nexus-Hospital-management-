@inject BurhanNexus.HMS.Infrastructure.Licensing.ILicenseService LicenseSvc
@inject ISettingsService SettingsSvc
@{
    var profile = await Fmt.ProfileAsync();
    var perms = await PermCtx.GetAsync();
    var license = await LicenseSvc.GetStatusAsync();
    var security = await SettingsSvc.GetSecurityAsync();
    var nav = ViewData["Nav"] as string ?? "";
    var hospitalName = profile?.HospitalName ?? "Burhan Nexus Hospital Management";
    string Active(string key) => nav == key ? "active" : "";
    bool Any(params string[] keys) => keys.Any(perms.Contains);
    var isPrivate = profile?.HospitalType == HospitalType.Private;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · @hospitalName</title>
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app" data-session-timeout="@security.SessionTimeoutMinutes">
<partial name="_Icons" />
<aside class="sidebar" id="sidebar">
    <a class="brand" href="/">
        <img class="brand-logo" src="/branding/logo?v=@(profile?.LogoVersion ?? 0)" alt="Logo" />
        <span class="brand-text">
            <strong>@hospitalName</strong>
            <small>Burhan Nexus HMS</small>
        </span>
    </a>
    <nav class="nav">
        @if (perms.Contains(Perm.DashboardView))
        {
            <a class="nav-link @Active("dashboard")" href="/"><svg class="icon"><use href="#i-home" /></svg><span>Dashboard</span></a>
        }

        @if (isPrivate && Any(Perm.AppointmentsView, Perm.AppointmentsAdd, Perm.AppointmentsReports))
        {
            <div class="nav-section">Appointments</div>
            @if (perms.Contains(Perm.AppointmentsAdd))
            {
                <a class="nav-link @Active("appointment-book")" href="/Appointments/Book" data-nav="appointment-book"><svg class="icon"><use href="#i-plus" /></svg><span>New Appointment</span></a>
            }
            @if (perms.Contains(Perm.AppointmentsView))
            {
                <a class="nav-link @Active("appointments")" href="/Appointments" data-nav="appointments"><svg class="icon"><use href="#i-calendar" /></svg><span>Doctor-wise Lists</span></a>
            }
            @if (perms.Contains(Perm.AppointmentsReports))
            {
                <a class="nav-link @Active("appointment-reports")" href="/Appointments/Reports"><svg class="icon"><use href="#i-chart" /></svg><span>Appointment Reports</span></a>
            }
        }

        @if (Any(Perm.PatientsAdd, Perm.PatientsSearch, Perm.OpdView, Perm.OpdAdd, Perm.EmergencyView, Perm.EmergencyAdd))
        {
            <div class="nav-section">Patients &amp; Visits</div>
            @if (perms.Contains(Perm.PatientsAdd))
            {
                <a class="nav-link @Active("patient-register")" href="/Patients/Register"><svg class="icon"><use href="#i-plus" /></svg><span>Register Patient</span></a>
            }
            @if (perms.Contains(Perm.PatientsSearch))
            {
                <a class="nav-link @Active("patients")" href="/Patients"><svg class="icon"><use href="#i-search" /></svg><span>Patient Search</span></a>
            }
            @if (perms.Contains(Perm.OpdView))
            {
                <a class="nav-link @Active("opd")" href="/Opd"><svg class="icon"><use href="#i-stethoscope" /></svg><span>OPD</span></a>
            }
            else if (perms.Contains(Perm.OpdAdd) && !(isPrivate && perms.Contains(Perm.AppointmentsAdd)))
            {
                <a class="nav-link @Active("opd")" href="/Opd/Register"><svg class="icon"><use href="#i-stethoscope" /></svg><span>OPD Registration</span></a>
            }
            @if (perms.Contains(Perm.EmergencyView))
            {
                <a class="nav-link @Active("emergency")" href="/Emergency"><svg class="icon"><use href="#i-siren" /></svg><span>Emergency</span></a>
            }
            else if (perms.Contains(Perm.EmergencyAdd))
            {
                <a class="nav-link @Active("emergency")" href="/Emergency/Register"><svg class="icon"><use href="#i-siren" /></svg><span>Emergency Registration</span></a>
            }
        }

        @if (Any(Perm.FinanceViewOwnAccount, Perm.FinanceCollect, Perm.FinanceViewOwnReceipts, Perm.FinanceDashboard, Perm.FinanceConfirmDeposits, Perm.FinanceManageDoctorAccounts, Perm.FinanceCounterReports, Perm.FinanceManageServiceFees))
        {
            <div class="nav-section">Finance</div>
            @if (perms.Contains(Perm.FinanceCollect))
            {
                <a class="nav-link @Active("finance-collect")" href="/Finance/Collect" data-nav="finance-collect"><svg class="icon"><use href="#i-plus" /></svg><span>Collect Payment</span></a>
            }
            @if (perms.Contains(Perm.FinanceViewOwnAccount))
            {
                <a class="nav-link @Active("finance-account")" href="/Finance" data-nav="finance-account"><svg class="icon"><use href="#i-wallet" /></svg><span>My Financial Account</span></a>
            }
            @if (perms.Contains(Perm.FinanceViewOwnReceipts))
            {
                <a class="nav-link @Active("finance-receipts")" href="/Finance/Receipts" data-nav="finance-receipts"><svg class="icon"><use href="#i-file" /></svg><span>Receipts</span></a>
            }
            @if (perms.Contains(Perm.FinanceDashboard))
            {
                <a class="nav-link @Active("finance-dashboard")" href="/Finance/Dashboard" data-nav="finance-dashboard"><svg class="icon"><use href="#i-chart" /></svg><span>Financial Dashboard</span></a>
            }
            @if (perms.Contains(Perm.FinanceConfirmDeposits))
            {
                <a class="nav-link @Active("finance-deposits")" href="/Finance/Deposits" data-nav="finance-deposits"><svg class="icon"><use href="#i-download" /></svg><span>Cash Deposits</span></a>
            }
            @if (perms.Contains(Perm.FinanceManageDoctorAccounts))
            {
                <a class="nav-link @Active("finance-doctors")" href="/Finance/Doctors" data-nav="finance-doctors"><svg class="icon"><use href="#i-stethoscope" /></svg><span>Doctor Accounts</span></a>
            }
            @if (perms.Contains(Perm.FinanceManageServiceFees))
            {
                <a class="nav-link @Active("finance-services")" href="/Finance/Services" data-nav="finance-services"><svg class="icon"><use href="#i-sliders" /></svg><span>Services &amp; Fees</span></a>
            }
        }

        @if (Any(Perm.UsersView, Perm.DepartmentsManage, Perm.RolesManage, Perm.LoginHistoryView, Perm.AuditView))
        {
            <div class="nav-section">Administration</div>
            @if (perms.Contains(Perm.UsersView))
            {
                <a class="nav-link @Active("users")" href="/Users"><svg class="icon"><use href="#i-users" /></svg><span>Users</span></a>
            }
            @if (perms.Contains(Perm.DepartmentsManage))
            {
                <a class="nav-link @Active("departments")" href="/Departments"><svg class="icon"><use href="#i-building" /></svg><span>Departments</span></a>
            }
            @if (perms.Contains(Perm.RolesManage))
            {
                <a class="nav-link @Active("roles")" href="/Roles"><svg class="icon"><use href="#i-badge" /></svg><span>Responsibilities</span></a>
            }
            @if (perms.Contains(Perm.LoginHistoryView))
            {
                <a class="nav-link @Active("logins")" href="/Users/LoginHistory"><svg class="icon"><use href="#i-history" /></svg><span>Login History</span></a>
            }
            @if (perms.Contains(Perm.AuditView))
            {
                <a class="nav-link @Active("audit")" href="/Audit"><svg class="icon"><use href="#i-shield" /></svg><span>Audit Log</span></a>
            }
        }

        @if (Any(Perm.SettingsView, Perm.LicenseView, Perm.BackupView, Perm.PatientsSettings))
        {
            <div class="nav-section">System</div>
            @if (perms.Contains(Perm.PatientsSettings) && !perms.Contains(Perm.SettingsView))
            {
                <a class="nav-link @Active("registration-settings")" href="/Settings/Registration"><svg class="icon"><use href="#i-badge" /></svg><span>Patient ID &amp; Slips</span></a>
            }
            @if (perms.Contains(Perm.SettingsView))
            {
                <a class="nav-link @Active("settings")" href="/Settings"><svg class="icon"><use href="#i-settings" /></svg><span>Hospital Settings</span></a>
            }
            @if (perms.Contains(Perm.LicenseView))
            {
                <a class="nav-link @Active("license")" href="/Settings/License"><svg class="icon"><use href="#i-key" /></svg><span>License</span></a>
            }
            @if (perms.Contains(Perm.BackupView))
            {
                <a class="nav-link @Active("backup")" href="/Backup"><svg class="icon"><use href="#i-database" /></svg><span>Backup &amp; Restore</span></a>
            }
        }
    </nav>
    <div class="sidebar-footer">Burhan Nexus · v1.0 · Phase 1</div>
</aside>
<div class="sidebar-backdrop" data-sidebar-close></div>

<div class="main">
    <header class="topbar">
        <button type="button" class="icon-btn sidebar-toggle" data-sidebar-toggle aria-label="Menu"><svg class="icon"><use href="#i-menu" /></svg></button>
        <h1 class="page-title">@ViewData["Title"]</h1>
        <div class="topbar-right">
            @if (!license.AllowsWrite && license.State != BurhanNexus.HMS.Core.Licensing.LicenseState.NotInitialized)
            {
                <span class="pill pill-danger" title="@license.Message"><svg class="icon icon-sm"><use href="#i-lock" /></svg> Read-only</span>
            }
            else if (license.State == BurhanNexus.HMS.Core.Licensing.LicenseState.TrialActive && perms.Contains(Perm.LicenseView))
            {
                <span class="pill pill-warning" title="@license.Message">Trial · @license.DaysRemaining days left</span>
            }
            <span class="topbar-clock" data-clock data-tz="@(profile?.TimeZoneId ?? "Asia/Karachi")"><svg class="icon icon-sm"><use href="#i-clock" /></svg> <span data-clock-text>@Fmt.DateTimeText(DateTime.UtcNow)</span></span>
            <div class="user-menu" data-dropdown>
                <button type="button" class="user-btn" data-dropdown-toggle>
                    <span class="avatar">@(User.GetFullName().Length > 0 ? User.GetFullName()[..1].ToUpperInvariant() : "U")</span>
                    <span class="user-name">@User.GetFullName()</span>
                </button>
                <div class="dropdown">
                    <div class="dropdown-header"><strong>@User.GetFullName()</strong><small>@@@User.Identity?.Name</small></div>
                    <a href="/Account/ChangePassword"><svg class="icon icon-sm"><use href="#i-lock" /></svg> Change password</a>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit"><svg class="icon icon-sm"><use href="#i-logout" /></svg> Log out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>
    <main class="content">
        <partial name="_Flash" />
        @RenderBody()
    </main>
</div>

<div class="modal-backdrop" id="session-warning" hidden>
    <div class="modal">
        <h3><svg class="icon"><use href="#i-clock" /></svg> Session about to expire</h3>
        <p>You have been inactive. For security you will be logged out in <strong data-session-countdown>60</strong> seconds.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-primary" data-session-continue>Stay logged in</button>
        </div>
    </div>
</div>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
