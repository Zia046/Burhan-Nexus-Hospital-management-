@page
@model BurhanNexus.HMS.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<div class="card card-narrow">
    <div class="card-header"><h2><svg class="icon"><use href="#i-lock" /></svg> Change your password</h2></div>
    <form method="post" class="card-body" novalidate>
        @if (Model.Forced)
        {
            <div class="alert alert-warning"><svg class="icon"><use href="#i-info" /></svg><div>Your administrator requires you to set a new password before continuing.</div></div>
        }
        <partial name="_ValidationSummary" />
        <div class="field">
            <label asp-for="CurrentPassword">Current password</label>
            <input asp-for="CurrentPassword" autocomplete="current-password" required />
        </div>
        <div class="field">
            <label asp-for="NewPassword">New password</label>
            <div class="input-icon no-lead">
                <input asp-for="NewPassword" autocomplete="new-password" required data-password data-strength />
                <button type="button" class="input-action" data-toggle-password aria-label="Show password"><svg class="icon"><use href="#i-eye" /></svg></button>
            </div>
            <small class="muted">At least 8 characters with letters and numbers.</small>
            <div class="strength" data-strength-bar><span></span></div>
        </div>
        <div class="field">
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" required />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit"><svg class="icon icon-sm"><use href="#i-check" /></svg> Change password</button>
        </div>
    </form>
</div>
