@page
@model BurhanNexus.HMS.Web.Pages.Ipd.AdmitModel
@{ ViewData["Title"] = Model.IsGynae ? "Gynae admission" : "IPD admission"; var p = Model.Patient; var i = Model.Input; }
<partial name="_IpdNav" />
@if (p is null)
{
    @await Html.PartialAsync("_PatientPick", (Model.IsGynae ? "Gynae admission – find the patient" : "Admit a patient – find the patient", Model.Q, Model.Matches,
        "/Ipd/Admit?patientId={0}" + (Model.IsGynae ? "&kind=gynae" : ""), Model.IsGynae ? "<input type=\"hidden\" name=\"kind\" value=\"gynae\" />" : ""))
}
else
{
    <form method="post" class="grid-side" novalidate data-ipd-admit>
        <input type="hidden" name="Input.IdempotencyKey" value="@i.IdempotencyKey" />
        <input type="hidden" name="PatientId" value="@p.Id" />
        <input type="hidden" name="Kind" value="@Model.Kind" />
        <input type="hidden" name="Input.Kind" value="@(Model.IsGynae ? "Gynae" : "General")" />
        <div class="card">
            <div class="card-header"><h2><svg class="icon"><use href="#i-hospital" /></svg> @(Model.IsGynae ? "Gynae admission" : "Admission")</h2></div>
            <div class="card-body">
                <partial name="_ValidationSummary" />
                @if (Model.Current is { } cur) { <div class="alert alert-warning"><svg class="icon"><use href="#i-alert" /></svg><div>Already admitted: <a href="/Ipd/Admission/@cur.Id">@cur.AdmissionNumber</a>. Use transfer instead of a second admission.</div></div> }
                <div class="grid-2">
                    <div class="field"><label for="Input_Source">Admission source</label><select id="Input_Source" name="Input.Source">
                        @foreach (var s in new[] { AdmissionSource.Opd, AdmissionSource.Emergency, AdmissionSource.Gynae, AdmissionSource.Maternity, AdmissionSource.ExternalReferral, AdmissionSource.Direct, AdmissionSource.Other })
                        { <option value="@s" selected="@(i.Source == s)">@s</option> }</select></div>
                    <div class="field"><label for="Input_SourceEncounterId">OPD / Emergency visit</label><select id="Input_SourceEncounterId" name="Input.SourceEncounterId"><option value="">—</option>
                        @foreach (var v in Model.Visits) { <option value="@v.Id" selected="@(i.SourceEncounterId == v.Id)">@v.EncounterNumber · @Fmt.Day(v.EncounterDate)@(v.Doctor is null ? "" : " · " + v.Doctor.Name)</option> }</select></div>
                    <div class="field"><label for="Input_DepartmentId">Department</label><select id="Input_DepartmentId" name="Input.DepartmentId"><option value="">—</option>
                        @foreach (var d in Model.Departments) { <option value="@d.Id" selected="@(i.DepartmentId == d.Id)">@d.Name</option> }</select></div>
                    <div class="field"><label for="Input_ReferringDoctor">Referring doctor</label><input id="Input_ReferringDoctor" name="Input.ReferringDoctor" value="@i.ReferringDoctor" maxlength="150" /></div>
                    <div class="field"><label for="Input_AdmittingDoctorId">Admitting doctor</label><select id="Input_AdmittingDoctorId" name="Input.AdmittingDoctorId"><option value="">—</option>
                        @foreach (var d in Model.Doctors) { <option value="@d.Id" selected="@(i.AdmittingDoctorId == d.Id)">@d.Name</option> }</select></div>
                    <div class="field"><label for="Input_AdmittingDoctorName">Admitting doctor (if not listed)</label><input id="Input_AdmittingDoctorName" name="Input.AdmittingDoctorName" value="@i.AdmittingDoctorName" maxlength="150" /></div>
                    <div class="field"><label for="Input_AdmittedLocal">Admission date / time</label><input id="Input_AdmittedLocal" type="datetime-local" name="Input.AdmittedLocal" value="@i.AdmittedLocal?.ToString("yyyy-MM-ddTHH:mm")" /></div>
                </div>
                <div class="field"><label for="Input_AdmissionDiagnosis">Admission diagnosis (as written by the doctor)</label><input id="Input_AdmissionDiagnosis" name="Input.AdmissionDiagnosis" value="@i.AdmissionDiagnosis" maxlength="500" /></div>
                <div class="grid-2">
                    <div class="field"><label for="Input_InitialCondition">Initial condition</label><input id="Input_InitialCondition" name="Input.InitialCondition" value="@i.InitialCondition" maxlength="500" /></div>
                    <div class="field"><label for="Input_Allergies">Allergies</label><input id="Input_Allergies" name="Input.Allergies" value="@i.Allergies" maxlength="500" placeholder="Known allergies / none known" /></div>
                </div>
                <div class="field"><label for="Input_MedicalHistory">Relevant medical history</label><textarea id="Input_MedicalHistory" name="Input.MedicalHistory" rows="2" maxlength="2000">@i.MedicalHistory</textarea></div>
                <h3 class="section-title">Attendant</h3>
                <div class="grid-3">
                    <div class="field"><label for="Input_AttendantName">Name</label><input id="Input_AttendantName" name="Input.AttendantName" value="@i.AttendantName" maxlength="150" /></div>
                    <div class="field"><label for="Input_AttendantRelation">Relation</label><input id="Input_AttendantRelation" name="Input.AttendantRelation" value="@i.AttendantRelation" maxlength="50" /></div>
                    <div class="field"><label for="Input_AttendantPhone">Phone</label><input id="Input_AttendantPhone" name="Input.AttendantPhone" value="@i.AttendantPhone" maxlength="30" /></div>
                </div>
                <h3 class="section-title">Ward, room &amp; bed</h3>
                <div bn-permission="@Perm.IpdAllocateBed">@await Html.PartialAsync("_BedSelect", (Model.Beds, "Input.BedId", i.BedId, false))</div>
            </div>
            @if (Model.AdmissionFee is decimal fee)
            {
                <fieldset class="fee-box" data-admission-fee="@fee.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <legend>Admission fee: <strong>@Fmt.Money(fee)</strong></legend>
                    @if (fee > 0)
                    {
                        <div class="checks">
                            <label class="check"><input type="radio" name="FeeAction" value="later" checked="@(Model.FeeAction is null or "later")" /> Not received now (stays on the patient's account)</label>
                            @if (Model.CanPayFee) { <label class="check"><input type="radio" name="FeeAction" value="pay" checked="@(Model.FeeAction == "pay")" data-test="fee-pay" /> Received now</label> }
                            @if (Model.CanWaiveFee) { <label class="check"><input type="radio" name="FeeAction" value="waive" checked="@(Model.FeeAction == "waive")" /> Free admission (authorised waiver)</label> }
                        </div>
                        <div class="grid-2">
                            @if (Model.CanPayFee)
                            {
                                <div class="field"><label for="fm">Payment method</label><select id="fm" name="FeeMethodId">@foreach (var pm in Model.Methods) { <option value="@pm.Id" selected="@(pm.Code == "CASH")">@pm.Name</option> }</select></div>
                                <div class="field"><label for="fr">Reference</label><input id="fr" name="FeeReference" maxlength="100" /></div>
                            }
                            @if (Model.CanWaiveFee) { <div class="field"><label for="fw">Reason for free admission</label><input id="fw" name="FeeWaiverReason" maxlength="200" /></div> }
                        </div>
                    }
                </fieldset>
            }
            <div class="card-footer form-actions"><a class="btn btn-light" href="/Ipd/Admit">Change patient</a><button class="btn btn-primary btn-lg" type="submit" data-test="ipd-admit-save" data-once>Admit patient</button></div>
        </div>
        <div class="card patient-mini"><div class="card-body">
            <div class="patient-id-box sm"><small>Patient ID</small><strong>@p.PatientNumber</strong></div>
            <h3>@p.FullName</h3>
            <dl class="kv kv-tight">
                <dt>Father / Husband</dt><dd>@(p.GuardianName ?? "—")</dd>
                <dt>Age / Gender</dt><dd>@Model.AgeText · @p.Gender</dd>
                <dt>Phone</dt><dd>@(p.MobileNumber ?? "—")</dd>
                <dt>CNIC</dt><dd>@(p.Cnic ?? "—")</dd>
                <dt>Address</dt><dd>@(p.Address ?? p.CityOrVillage ?? "—")</dd>
            </dl>
            <a bn-permission="@Perm.PatientsView" href="/Patients/Profile/@p.Id">Open profile</a>
        </div></div>
    </form>
}
@section Scripts { <script src="~/js/ipd.js" asp-append-version="true"></script> }
