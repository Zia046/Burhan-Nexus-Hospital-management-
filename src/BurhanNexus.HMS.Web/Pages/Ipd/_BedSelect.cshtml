@model (IReadOnlyList<IpdBed> Beds, string Name, int? Selected, bool Required)
@{
    // Update 11: Ward → rooms of that ward → vacant beds of that room. No bed-type filter (the type stays on the bed record).
    var selectedBed = Model.Beds.FirstOrDefault(b => b.Id == Model.Selected);
    var wards = Model.Beds.Select(b => b.Ward!).DistinctBy(w => w.Id).OrderBy(w => w.Name).ToList();
    var rooms = Model.Beds.Select(b => b.Room!).DistinctBy(r => r.Id).OrderBy(r => r.Name).ToList();
}
<div class="field" data-bed-select>
    <label>Ward → room → bed @(Model.Required ? "*" : "(optional – can be allocated later)")</label>
    <div class="grid-3">
        <select data-bed-ward aria-label="Ward" data-test="bed-ward">
            <option value="">— select ward —</option>
            @foreach (var w in wards) { <option value="@w.Id" selected="@(selectedBed?.WardId == w.Id)">@w.Name (@Model.Beds.Count(b => b.WardId == w.Id) vacant)</option> }
        </select>
        <select data-bed-room aria-label="Room" data-test="bed-room">
            <option value="">— select room —</option>
            @foreach (var r in rooms) { <option value="@r.Id" data-ward="@r.WardId" selected="@(selectedBed?.RoomId == r.Id)">@r.Name (@Model.Beds.Count(b => b.RoomId == r.Id) vacant)</option> }
        </select>
        <select name="@Model.Name" data-bed-list aria-label="Bed" data-test="bed-bed">
            <option value="">@(Model.Required ? "— select a bed —" : "— no bed yet —")</option>
            @foreach (var b in Model.Beds.OrderBy(b => b.Code))
            {
                <option value="@b.Id" data-ward="@b.WardId" data-room="@b.RoomId" selected="@(Model.Selected == b.Id)">@b.Code@(b.Status == BedStatus.Reserved ? " (reserved)" : "")@(b.EquipmentId is null ? "" : " · " + b.EquipmentId)</option>
            }
        </select>
    </div>
    @if (Model.Beds.Count == 0) { <small class="text-warning">No vacant bed – discharge / transfer a patient or add beds.</small> }
</div>
