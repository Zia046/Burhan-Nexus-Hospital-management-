    <a bn-permission="@Perm.IpdRegisterAdmission" class="@Cls("admit")" href="/Ipd/Admit"><svg class="icon icon-sm"><use href="#i-plus" /></svg> Admit</a>
    <a bn-permission="@Perm.IpdViewPatients" class="@Cls("patients")" href="/Ipd/Admissions"><svg class="icon icon-sm"><use href="#i-users" /></svg> Inpatients</a>
    <a bn-permission="@Perm.IpdViewPatients|@Perm.IpdAllocateBed|@Perm.IpdManageBeds" class="@Cls("beds")" href="/Ipd/Beds"><svg class="icon icon-sm"><use href="#i-hospital" /></svg> Bed map</a>
    <a bn-permission="@Perm.IpdViewGynae" class="@Cls("gynae")" href="/Ipd/Gynae"><svg class="icon icon-sm"><use href="#i-stethoscope" /></svg> Gynae &amp; ANC</a>
