@page
@model BurhanNexus.HMS.Web.Pages.Appointments.ReportsModel
@{
    ViewData["Title"] = "Appointment reports";
    // Breakdown rows: per day for day/month, per month for year.
    var byMonth = Model.Period == "year";
    var buckets = Model.Daily
        .GroupBy(d => byMonth ? new DateOnly(d.Date.Year, d.Date.Month, 1) : d.Date)
        .OrderBy(g => g.Key)
        .Select(g => new
        {
            Key = g.Key,
            Booked = g.Where(x => x.Status != AppointmentStatus.Cancelled).Sum(x => x.Count),
            Cancelled = g.Where(x => x.Status == AppointmentStatus.Cancelled).Sum(x => x.Count),
            PerDoctor = g.Where(x => x.Status != AppointmentStatus.Cancelled).GroupBy(x => x.DoctorId).ToDictionary(x => x.Key, x => x.Sum(y => y.Count))
        }).ToList();
    var activeDoctors = Model.Stats.Where(s => s.Total > 0).ToList();
}
<div class="toolbar no-print">
    <form method="get" class="filters wrap">
        <select name="period" aria-label="Period" data-period-select>
            <option value="day" selected="@(Model.Period == "day")">Daily</option>
            <option value="month" selected="@(Model.Period == "month")">Monthly</option>
            <option value="year" selected="@(Model.Period == "year")">Yearly</option>
        </select>
        @switch (Model.Period)
        {
            case "month": <input type="month" name="month" value="@Model.Month" aria-label="Month" /> break;
            case "year": <input type="number" name="year" value="@Model.Year" min="2000" max="2200" aria-label="Year" style="width:100px" /> break;
            default: <input type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" aria-label="Date" /> break;
        }
        <select name="doctor" aria-label="Doctor"><option value="">All doctors</option>
            @foreach (var d in Model.Doctors) { <option value="@d.Id" selected="@(Model.DoctorId == d.Id)">@d.Name</option> }</select>
        <button class="btn btn-light" type="submit">Show</button>
    </form>
    <div class="toolbar-actions">
        <button bn-permission="@Perm.AppointmentsReports" type="button" class="btn btn-light" data-print><svg class="icon icon-sm"><use href="#i-printer" /></svg> Print / PDF</button>
    </div>
</div>

<div class="card">
    <div class="card-header"><h2><svg class="icon"><use href="#i-chart" /></svg> Doctor-wise appointments – @Model.Title</h2>
        <span class="pill pill-blue">@Model.Stats.Sum(s => s.Booked) booked · @Model.Stats.Sum(s => s.Cancelled) cancelled</span></div>
    <div class="table-wrap">
        <table class="table" data-report-stats>
            <thead><tr><th>Doctor</th><th>Specialization</th><th class="num">Booked</th><th class="num">Paid</th><th class="num">Free</th><th class="num">Free by Doctor</th><th class="num">Cancelled</th><th class="num">Tokens issued</th>@if (Model.ShowFees) { <th class="num">Fees collected</th><th class="num">Waived</th> }</tr></thead>
            <tbody>
            @foreach (var s in Model.Stats)
            {
                <tr data-doctor-row="@s.DoctorId"><td><strong>@s.DoctorName</strong></td><td>@s.Specialty</td><td class="num"><strong data-active>@s.Booked</strong></td><td class="num">@s.Paid</td>
                    <td class="num">@s.Free</td><td class="num" data-free-by-doctor>@s.FreeByDoctor</td><td class="num">@s.Cancelled</td><td class="num">@s.Total</td>
                    @if (Model.ShowFees) { <td class="num">@Fmt.Money(s.Collected)</td><td class="num" data-waived>@Fmt.Money(s.Waived)</td> }</tr>
            }
            @if (Model.Stats.Count == 0) { <tr><td colspan="10" class="empty">No doctors.</td></tr> }
            </tbody>
            <tfoot><tr><th colspan="2">Total</th><th class="num">@Model.Stats.Sum(s => s.Booked)</th><th class="num">@Model.Stats.Sum(s => s.Paid)</th><th class="num">@Model.Stats.Sum(s => s.Free)</th><th class="num">@Model.Stats.Sum(s => s.FreeByDoctor)</th><th class="num">@Model.Stats.Sum(s => s.Cancelled)</th><th class="num">@Model.Stats.Sum(s => s.Total)</th>
                @if (Model.ShowFees) { <th class="num">@Fmt.Money(Model.Stats.Sum(s => s.Collected))</th><th class="num" data-total-waived>@Fmt.Money(Model.Stats.Sum(s => s.Waived))</th> }</tr></tfoot>
        </table>
    </div>
</div>

@if (Model.Period != "day")
{
    <div class="card">
        <div class="card-header"><h3>@(byMonth ? "Month-wise" : "Day-wise") history (active appointments per doctor)</h3></div>
        <div class="table-wrap">
            <table class="table table-compact">
                <thead><tr><th>@(byMonth ? "Month" : "Date")</th>@foreach (var d in activeDoctors) { <th class="num">@d.DoctorName</th> }<th class="num">Active</th><th class="num">Cancelled</th></tr></thead>
                <tbody>
                @foreach (var b in buckets)
                {
                    <tr>
                        <td class="nowrap">@if (byMonth) { @b.Key.ToString("MMM yyyy") } else { <a href="/Appointments/Reports?period=day&date=@b.Key.ToString("yyyy-MM-dd")">@Fmt.Day(b.Key)</a> }</td>
                        @foreach (var d in activeDoctors) { <td class="num">@(b.PerDoctor.TryGetValue(d.DoctorId, out var c) ? c : 0)</td> }
                        <td class="num"><strong>@b.Booked</strong></td><td class="num">@b.Cancelled</td>
                    </tr>
                }
                @if (buckets.Count == 0) { <tr><td colspan="@(activeDoctors.Count + 3)" class="empty">No appointments in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.ShowFees)
{
    <div class="card" data-waiver-report>
        <div class="card-header"><h3>Free by Doctor (fee waivers)</h3><span class="pill pill-blue">@Model.Waivers.Count · @Fmt.Money(Model.Waivers.Sum(w => w.Waived))</span></div>
        <div class="grid-2 card-body">
            <table class="table table-compact"><thead><tr><th>Doctor (waived by)</th><th class="num">Waivers</th><th class="num">Amount</th><th class="num">After payment</th></tr></thead><tbody>
            @foreach (var g in Model.Waivers.GroupBy(w => w.WaiverDoctorName ?? w.DoctorName)) { <tr><td>@g.Key</td><td class="num">@g.Count()</td><td class="num">@Fmt.Money(g.Sum(w => w.Waived))</td><td class="num">@Fmt.Money(g.Where(w => w.AfterPayment).Sum(w => w.Waived))</td></tr> }
            @if (Model.Waivers.Count == 0) { <tr><td colspan="4" class="empty">None.</td></tr> }
            </tbody></table>
            <table class="table table-compact"><thead><tr><th>Recorded by (user)</th><th class="num">Waivers</th><th class="num">Amount</th></tr></thead><tbody>
            @foreach (var g in Model.Waivers.GroupBy(w => w.WaivedBy ?? "—")) { <tr><td>@g.Key</td><td class="num">@g.Count()</td><td class="num">@Fmt.Money(g.Sum(w => w.Waived))</td></tr> }
            </tbody></table>
        </div>
        <div class="table-wrap"><table class="table table-compact" data-waiver-list>
            <thead><tr><th>Date</th><th>Appt. no.</th><th>Patient</th><th>Doctor</th><th>Waived by</th><th class="num">Original fee</th><th class="num">Waived</th><th>Collected before?</th><th>Cash refund</th><th>Reason</th><th>Recorded by</th></tr></thead>
            <tbody>
            @foreach (var w in Model.Waivers)
            {
                <tr><td class="nowrap">@Fmt.Day(w.Date)</td><td class="mono"><a href="/Appointments/Details/@w.AppointmentId">@w.AppointmentNumber</a></td><td>@w.PatientName <small class="muted">@w.PatientNumber</small></td><td>@w.DoctorName</td><td>@w.WaiverDoctorName</td>
                    <td class="num">@Fmt.Money(w.OriginalFee)</td><td class="num">@Fmt.Money(w.Waived)</td><td>@(w.AfterPayment ? "Yes – doctor account adjusted" : "No")</td><td>@(w.RefundNumber is null ? "—" : $"{w.RefundNumber} ({w.RefundStatus})")</td><td>@w.Reason</td><td>@w.WaivedBy @Fmt.DateTimeText(w.WaivedUtc)</td></tr>
            }
            </tbody></table></div>
        <p class="card-body small muted">Doctor-wise earnings after waivers (share, waiver adjustments, refunds, settlements) are in Finance → Doctor accounts.</p>
    </div>
}

<div class="card">
    <div class="card-header"><h3>Cancelled appointments</h3><span class="pill pill-danger">@Model.Cancelled.Count</span></div>
    <div class="table-wrap">
        <table class="table table-compact" data-cancelled-list>
            <thead><tr><th>Date</th><th>Doctor</th><th>Token</th><th>Appt. no.</th><th>Patient</th><th>Reason</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Cancelled)
            {
                <tr><td class="nowrap">@Fmt.Day(c.AppointmentDate)</td><td>@c.DoctorName</td><td><span class="token">@c.TokenNumber</span></td>
                    <td class="mono"><a href="/Appointments/Details/@c.Id">@c.AppointmentNumber</a></td><td>@c.PatientName <small class="muted">@c.PatientNumber</small></td><td>@c.CancelReason</td></tr>
            }
            @if (Model.Cancelled.Count == 0) { <tr><td colspan="6" class="empty">No cancelled appointments.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
