@page
@model BurhanNexus.HMS.Web.Pages.Appointments.DoctorsModel
@{
    ViewData["Title"] = "Doctors";
    var f = Model.Form;
}
<div class="page-header">
    <div><h1>Doctors</h1><p class="muted">Doctors for the consultant tokens (Doctor-wise Lists). Inactive doctors are not offered for new appointments; their old records stay.</p></div>
    <div class="toolbar-actions">
        <a class="btn btn-light" href="/Appointments">Doctor-wise Lists</a>
        @if (Model.CanManage) { <a class="btn btn-primary" href="/Appointments/Doctors?new=true" data-add-doctor><svg class="icon icon-sm"><use href="#i-plus" /></svg> Add Doctor</a> }
    </div>
</div>
<partial name="_ValidationSummary" />
@if (Model.ShowForm)
{
    <form method="post" asp-route-edit="@Model.Editing?.Id" class="card" novalidate data-doctor-form>
        <div class="card-header"><h2>@(Model.Editing is null ? "Add Doctor" : "Edit " + Model.Editing.Name)</h2></div>
        <div class="card-body form-grid">
            <div class="field span-2"><label for="Form_Name">Doctor name <em>*</em></label><input id="Form_Name" name="Form.Name" value="@f.Name" maxlength="150" required placeholder="Dr. ..." /></div>
            <div class="field"><label for="Fee">Consultation fee @if (Model.CanFees && Model.Editing is null) { <em>*</em> }</label>
                @if (Model.CanFees)
                {
                    <input id="Fee" name="Fee" type="number" step="0.01" min="0" value="@Model.Fee?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    <label class="check small"><input type="checkbox" name="FeeIsFree" value="true" checked="@Model.FeeIsFree" /> FREE</label>
                    <small class="muted">A change applies to new appointments only.</small>
                }
                else { <input id="Fee" value="@(Model.Editing is { } ed && Model.Fees.TryGetValue(ed.Id, out var cf) ? (cf.Free ? "FREE" : cf.Fee.ToString("N2")) : "set by the administrator")" disabled /> }</div>
            <div class="field"><label for="Form_Specialty">Specialty</label><input id="Form_Specialty" name="Form.Specialty" value="@f.Specialty" maxlength="100" /></div>
            <div class="field"><label for="Form_DepartmentId">Department</label><select id="Form_DepartmentId" name="Form.DepartmentId"><option value="">—</option>
                @foreach (var d in Model.Departments) { <option value="@d.Id" selected="@(f.DepartmentId == d.Id)">@d.Name</option> }</select></div>
            <div class="field"><label for="Form_ContactNumber">Contact number</label><input id="Form_ContactNumber" name="Form.ContactNumber" value="@f.ContactNumber" maxlength="30" inputmode="tel" /></div>
            <div class="field"><label for="Form_Qualification">Qualification</label><input id="Form_Qualification" name="Form.Qualification" value="@f.Qualification" maxlength="150" placeholder="MBBS, FCPS" /></div>
            <input type="hidden" name="Form.RegistrationNumber" value="@f.RegistrationNumber" />
            <div class="field"><label for="Form_IsActive">Status</label><select id="Form_IsActive" name="Form.IsActive"><option value="true" selected="@f.IsActive">Active</option><option value="false" selected="@(!f.IsActive)">Inactive</option></select></div>
        </div>
        <div class="card-footer form-actions"><a class="btn btn-light" href="/Appointments/Doctors">Cancel</a><button class="btn btn-primary" type="submit" data-save-doctor>Save</button></div>
    </form>
}
<div class="card">
    <div class="table-wrap"><table class="table table-compact" data-doctor-list>
        <thead><tr><th>Doctor</th><th>Specialty / department</th><th>Contact</th><th class="num">Consultation fee</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Doctors)
        {
            <tr data-doctor="@d.Id" class="@(d.IsActive ? "" : "row-muted")"><td><strong>@d.Name</strong>@if (d.Qualification is not null) { <small class="muted block">@d.Qualification</small> }</td>
                <td>@d.Specialty@(d.Department is null ? "" : (d.Specialty is null ? "" : " · ") + d.Department.Name)</td><td>@d.ContactNumber</td>
                <td class="num" data-doctor-fee>@(Model.Fees.TryGetValue(d.Id, out var fee) ? (fee.Free ? "FREE" : Fmt.Money(fee.Fee)) : "not set")</td>
                <td>@(d.IsActive ? "Active" : "Inactive")</td>
                <td class="actions">@if (Model.CanManage) { <a class="btn btn-light btn-sm" href="/Appointments/Doctors?edit=@d.Id">Edit</a> }</td></tr>
        }
        @if (Model.Doctors.Count == 0) { <tr><td colspan="6" class="empty">No doctors yet – add the first doctor.</td></tr> }
        </tbody>
    </table></div>
</div>
